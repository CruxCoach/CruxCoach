# ──────────────────────────────────────────────────────────────────────
# local.properties template
# ──────────────────────────────────────────────────────────────────────
# Copy this file to local.properties and fill in only the values you need.
# local.properties is gitignored — never commit the real file.
#
# Upstream defaults keep contributor builds simple. A downstream distribution
# is different: once any identity key changes, Gradle requires the complete
# fork identity set so a partial rebrand cannot silently retain upstream's
# package, support recipient, public-event namespace, or update channel.

# ─── Android SDK location ────────────────────────────────────────────
# Usually auto-written by Android Studio on first project import.
# Override manually if you keep the SDK somewhere non-standard.
# sdk.dir=/home/yourname/Android/Sdk

# ─── Release signing (optional for local development) ───────────────
# Debug builds do not need any of these keys. Release builds fail when
# RELEASE_STORE_FILE is empty so a distributable artifact can never silently
# use the public debug key. For a throwaway local release build only, pass
# -PallowDebugSignedRelease=true.
# See CONTRIBUTING.md → "Release signing" for the keytool recipe.
# RELEASE_STORE_FILE=.signing/release.jks
# RELEASE_STORE_PASSWORD=
# RELEASE_KEY_ALIAS=
# RELEASE_KEY_PASSWORD=

# ─── Fork identity (set the complete group for a distribution) ─────
# A fork's MAINTAINER_PUBKEY receives support/crash DMs and is the donation
# recipient. Payments resolve its current, signed Kind-0 `lud16`; no Lightning
# address is frozen into the APK. There is no Ko-fi destination in the app.
# See CONTRIBUTING.md → "Customizing for forks" and TRADEMARK.md.
# APPLICATION_ID=com.yourfork.android
# APP_DISPLAY_NAME=Your Fork
# MAINTAINER_PUBKEY=<64-char hex pubkey>
# APP_LINK_HOST=yourfork.example
# APP_SCHEME=yourfork
# BRAND_NAMESPACE=yourfork
# NOSTR_NAMESPACE_PREFIX=com.yourfork
# ANNOUNCE_NAMESPACE=com.yourfork.announce
# USER_AGENT_PRODUCT=YourFork

# ─── Auto-updater (all optional — defaults point at upstream Codeberg) ─
# The in-app updater polls this Forgejo/Gitea-compatible releases API and
# downloads <UPDATER_REPO_NAME>-<tag>.apk + .apk.sha256 sidecar per release.
# Disabled automatically when the app is installed from Zapstore.
# See CONTRIBUTING.md → "Customizing for forks" for the release-asset contract.
# UPDATER_API_BASE=https://codeberg.org/api/v1
# UPDATER_REPO_OWNER=yourhandle
# UPDATER_REPO_NAME=YourFork

# ─── Share via Zapstore (optional — defaults to upstream listing) ───
# QR code + shareable link surfaced in Settings → Share via Zapstore.
# Forks publishing to their own Zapstore namespace should override this
# so the in-app share button doesn't drive their users to upstream.
# ZAPSTORE_APP_URL=https://zapstore.dev/apps/com.yourfork.android

# ─── Brand-bound constants on the wire (HTTP and App Links) ─────────
# USER_AGENT_PRODUCT lands in the outgoing User-Agent header for the
# Kilter API client (`<product>/<version> (https://<host>)`). Lets Kilter
# operators tell forks apart from upstream traffic. Default: CruxCoach.
# USER_AGENT_PRODUCT=YourFork
#
# APP_LINK_HOST sets the host for shareable climb URLs and the Android
# App Link `<intent-filter>`. Forks need to host their own
# `/.well-known/assetlinks.json` for App Link verification to succeed;
# until then App Links fall back to opening in a browser. Default:
# cruxcoach.org.
# APP_SCHEME drives the unverifiable custom import URI. Use a distinct value
# to avoid Android handler collisions; the in-app confirmation remains the
# trust boundary for imports.
#
# BRAND_NAMESPACE prefixes user-owned public d-tags (community climbs,
# backups, key events). NOSTR_NAMESPACE_PREFIX drives their L/l labels.
# Auto-Notes add discovery hashtags only; they never add a hidden person tag.

# ─── Catalogue source (optional; defaults to upstream) ──────────────
# Keep these defaults to consume CruxCoach's attributed public catalogue.
# Override both when your fork publishes its own signed Blossom manifests.
# CATALOGUE_NAMESPACE=yourfork
# CATALOGUE_MANIFEST_PUBKEY=<64-char hex pubkey>
