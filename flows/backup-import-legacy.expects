# Two previews and two explicit cross-account approvals, without identifiers.
2+::DataExchangeVM.*event=import_preview board_sends=3 board_bids=1 climb_lists=2 pubkey_mismatch=true
2+::DataExchangeVM.*event=import_pubkey_override accepted=true

# First write and exact idempotent re-import result.
DataExchangeVM.*event=import_complete board_sends=3 board_bids=1 climb_lists=2 own_climbs=0 skipped=0 mismatch_override=true
DataExchangeVM.*event=import_complete board_sends=0 board_bids=0 climb_lists=2 own_climbs=0 skipped=4 mismatch_override=true
!DataExchangeVM.*event=import_complete.*mismatch_override=false
