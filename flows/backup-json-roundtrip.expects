# Preview and write audit are bound to this single isolated root's Logcat.
event=import_preview board_sends=2 board_bids=1 climb_lists=2 pubkey_mismatch=true
event=import_pubkey_override accepted=true
event=import_complete board_sends=2 board_bids=1 climb_lists=2 own_climbs=0 skipped=0 mismatch_override=true
!event=import_complete .*mismatch_override=false
!invalid backup|not finite|out of range
