+    /// A targeted nearby join can be a one-way connection. Android devices
+    /// are not guaranteed to observe the joiner's advertisement while they
+    /// advertise the occupied board and hold its BLE link. Identity ordering
+    /// alone must therefore never discard the only usable channel.
+    #[tokio::test]
+    async fn test_one_way_inbound_is_accepted_without_an_outbound_attempt() {
+        let (smaller, larger) = pubkeys_ordered_by_node_addr();
+        let io = MockBleIo::new("hci0", test_addr(1));
+        let (tx, _rx) = tokio::sync::mpsc::channel(64);
+        let mut transport =
+            BleTransport::new(TransportId::new(1), None, identity_test_config(), io, tx);
+        transport.set_local_pubkey(smaller);
+        transport.start_async().await.unwrap();
+
+        let (ours, peer) = MockBleStream::pair(test_addr(1), test_addr(2), 2048);
+        transport.io.inject_inbound(ours).await;
+        peer_side_exchange(&peer, &larger).await;
+        {
+            let pool = Arc::clone(&transport.pool);
+            wait_for("one-way inbound to enter the pool", || {
+                pool.try_lock().is_ok_and(|guard| guard.len() == 1)
+            })
+            .await;
+        }
