+                            .iter()
+                            .copied()
+                            .find(|candidate| *candidate != node && !pools[*candidate].is_full())
+                    });
+                let Some(target) = target else {
+                    retry.push((node, advertisers.clone()));
+                    capacity_redirects += 1;
