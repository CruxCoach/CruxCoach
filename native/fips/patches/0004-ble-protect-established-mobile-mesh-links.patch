+        const PARTICIPANTS: usize = 20;
+        const DEGREE: usize = 7;
+        let mut pools: Vec<ConnectionPool<()>> = (0..PARTICIPANTS)
+            .map(|_| ConnectionPool::new_with_policy(DEGREE, DEGREE))
