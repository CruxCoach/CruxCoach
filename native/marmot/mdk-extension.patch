+            hash.update(b"cruxcoach.marmot.session.v1");
+            hash.update(group_id.as_slice());
+            hash.update(group.epoch().as_u64().to_be_bytes());
+            hash.update(group.epoch_authenticator().as_slice());
+            let context = hash.finalize().to_vec();
+            let mut leaves = Vec::new();
+            for member in group.members() {
+                let credential = openmls::prelude::BasicCredential::try_from(member.credential)
+                    .map_err(|_| EngineError::Backend("invalid leaf credential".into()))?;
+                leaves.push((member.index.u32(), credential.identity().to_vec(), member.signature_key));
+            }
+            Ok((context, group.own_leaf_index().u32(), leaves))
+        })
     }
 
