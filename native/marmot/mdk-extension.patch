+//! Bounded opaque host journal on the existing SQLCipher transaction rail.
+//! It neither interprets permissions nor modifies MDK's schema version.
+use crate::{SqliteAccountStorage, SqliteResultExt};
+use cgka_traits::storage::{StorageError, StorageResult};
+use rusqlite::{params, OptionalExtension};
+
+impl SqliteAccountStorage {
+    pub fn cruxcoach_init(&self) -> StorageResult<()> {
+        self.lock()?.execute_batch("CREATE TABLE IF NOT EXISTS cruxcoach_journal_v1 (
+            key TEXT PRIMARY KEY NOT NULL, value BLOB NOT NULL
+        )").storage()
+    }
+
+    pub fn cruxcoach_get(&self, key: &str) -> StorageResult<Option<Vec<u8>>> {
+        self.lock()?.query_row("SELECT value FROM cruxcoach_journal_v1 WHERE key=?1",
+            [key], |row| row.get(0)).optional().storage()
+    }
+
+    pub fn cruxcoach_put(&self, key: &str, value: &[u8]) -> StorageResult<()> {
+        if key.len() > 256 || value.len() > 1_048_576 {
+            return Err(StorageError::Backend("host journal row limit".into()));
+        }
+        let conn = self.lock()?;
+        let (count, bytes): (i64, i64) = conn.query_row(
+            "SELECT count(*), coalesce(sum(length(value)),0) FROM cruxcoach_journal_v1 WHERE key != ?1",
+            [key], |r| Ok((r.get(0)?, r.get(1)?))).storage()?;
+        if count >= 4096 || bytes + value.len() as i64 > 33_554_432 {
+            return Err(StorageError::Backend("host journal capacity".into()));
+        }
+        conn.execute("INSERT INTO cruxcoach_journal_v1(key,value) VALUES(?1,?2)
+            ON CONFLICT(key) DO UPDATE SET value=excluded.value", params![key, value]).storage()?;
+        Ok(())
+    }
+
+    pub fn cruxcoach_delete(&self, key: &str) -> StorageResult<()> {
+        self.lock()?.execute("DELETE FROM cruxcoach_journal_v1 WHERE key=?1", [key]).storage()?;
+        Ok(())
+    }
+
+    pub fn cruxcoach_keys(&self, prefix: &str) -> StorageResult<Vec<String>> {
+        let conn = self.lock()?;
+        let mut query = conn.prepare("SELECT key FROM cruxcoach_journal_v1
+            WHERE substr(key,1,length(?1))=?1 ORDER BY key").storage()?;
+        query.query_map([prefix], |row| row.get(0)).storage()?
+            .collect::<Result<Vec<_>,_>>().storage()
+    }
+}
