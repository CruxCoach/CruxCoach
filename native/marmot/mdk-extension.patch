+//! CruxCoach host tables on the engine's SQLCipher connection and transaction
+//! rail. MDK neither reads nor migrates them; the host owns their schema and
+//! bounds. Runs inside an enclosing `with_transaction` on the same thread.
+use crate::{SqliteAccountStorage, SqliteResultExt};
+use cgka_traits::storage::StorageResult;
+
+impl SqliteAccountStorage {
+    pub fn cruxcoach_sql<R>(
+        &self,
+        f: impl FnOnce(&rusqlite::Connection) -> rusqlite::Result<R>,
+    ) -> StorageResult<R> {
+        let connection = self.lock()?;
+        f(&connection).storage()
+    }
+}
