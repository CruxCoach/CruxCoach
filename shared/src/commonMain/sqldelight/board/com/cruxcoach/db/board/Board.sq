-- Climbing-board catalog tables.
-- Schema-shape inherited from Aurora Climbing's original SQLite (climbs,
-- climb_stats, placements, holes, leds, product_sizes) — that shape is
-- preserved across Aurora-extracted bundles and the Blossom-mirror cron.

CREATE TABLE climbs (
    -- UUID identity: BINARY collation, lowercase canonical form. The
    -- Kilter blob carries UUIDs in mixed casing (~114k upper, ~60k
    -- lower) but the two casings are *not* the same logical climb on
    -- the cron's side — they carry divergent metadata. Importer
    -- writes LOWER(uuid) on every insert, the live sub lowercases
    -- parsed event UUIDs, and ClimbCreator generates lowercase UUIDs
    -- for new community climbs. 7.sqm wiped the Kilter side and
    -- normalized cruxcoach rows on upgrade. ClimbNameResolver still
    -- case-fanouts read paths (BLE protocol decodes uppercase) so
    -- legacy callers stay working.
    uuid TEXT NOT NULL PRIMARY KEY,
    layout_id INTEGER NOT NULL,
    setter_username TEXT,
    name TEXT NOT NULL,
    frames_count INTEGER NOT NULL DEFAULT 1,
    is_listed INTEGER NOT NULL DEFAULT 1,
    edge_left INTEGER,
    edge_right INTEGER,
    edge_bottom INTEGER,
    edge_top INTEGER,
    created_at TEXT,
    description TEXT NOT NULL DEFAULT '',
    is_nomatch INTEGER NOT NULL DEFAULT 0,
    frames_pace INTEGER NOT NULL DEFAULT 0,
    hsm INTEGER NOT NULL DEFAULT 0,
    frames BLOB AS kotlin.String NOT NULL,
    is_deleted INTEGER NOT NULL DEFAULT 0,
    move_count INTEGER NOT NULL DEFAULT 0,
    -- FEAT-003 community-climb fields:
    source TEXT NOT NULL DEFAULT 'kilter',          -- 'kilter' | 'nostr' | 'local' (data origin, mutable)
    nostr_event_id TEXT,                            -- Kind 30078 event id (set on publish)
    nostr_d_tag TEXT,                               -- d-tag of the published event
    created_by_pubkey TEXT,                         -- setter pubkey for nostr/local climbs
    frames_hash TEXT,                               -- canonical sha256 of frames+layout (dup detection)
    sync_status TEXT NOT NULL DEFAULT 'synced',     -- 'draft' | 'synced' | 'published_nostr' | 'published_kilter' | 'published_both' | 'failed'
    -- v0.1.5 provenance + Kilter publish status:
    origin TEXT NOT NULL DEFAULT 'kilter',          -- 'cruxcoach' | 'kilter' (immutable, where authored)
    kilter_status TEXT,                             -- NULL | 'pending' | 'synced' | 'failed' | 'diverged'
    kilter_synced_at INTEGER,                       -- epoch seconds, set when Kilter accepts
    kilter_publish_via TEXT,                        -- 'self' (user account) | 'cruxcoach' (bundled)
    kilter_error TEXT,                              -- last Kilter publish failure message
    -- v0.1.6 per-network identity tracking for Nostr
    nostr_publish_via TEXT,                         -- 'self' | 'cruxcoach' (bundled signing key)
    -- FEAT-027 multi-board support: which board family this climb
    -- belongs to. 'kilter' for the existing catalogue, 'moonboard'
    -- for MoonBoard climbs. Explicit so renderer / BLE / onboarding
    -- branch on a real column, not a layout_id range guess. Added by
    -- 14.sqm with DEFAULT 'kilter'.
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    -- Kilter author identity: the climb author's Kilter userUuid as
    -- reported by the user-scoped Kilter endpoints (/climbs/logged,
    -- /climbs/climbdetails/user). Backs the own-Kilter-climb publish
    -- gate, which compares this against the CONNECTED account's
    -- userUuid (never a display-name match). NULL = unknown author →
    -- not publishable. Added by 22.sqm — must stay the LAST column so
    -- the migration's ALTER TABLE ADD COLUMN matches this schema.
    kilter_author_uuid TEXT
);

CREATE TABLE climb_stats (
    -- Pairs with climbs.uuid (lowercase canonical, BINARY). See the
    -- climbs.uuid comment + 7.sqm migration for the full rationale.
    climb_uuid TEXT NOT NULL,
    angle INTEGER NOT NULL,
    display_difficulty REAL,
    difficulty_average REAL,
    quality_average REAL,
    ascensionist_count INTEGER DEFAULT 0,
    benchmark_difficulty REAL,
    fa_username TEXT,
    fa_at TEXT,
    official_kilter_difficulty INTEGER,
    -- Denormalized copy of climbs.layout_id, kept in lock-step by the
    -- importers and migration 15.sqm. Lets the browse/count indexes lead
    -- with layout_id so a query for one board never scans another board's
    -- same-angle rows — the Kilter + MoonBoard catalogues sharing one
    -- `angle` bucket is what made post-MoonBoard browse queries ~3s.
    layout_id INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (climb_uuid, angle)
);

CREATE TABLE board_hold_positions (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    hole_id INTEGER NOT NULL,
    product_size_id INTEGER NOT NULL,
    x INTEGER NOT NULL,
    y INTEGER NOT NULL,
    led_position INTEGER NOT NULL,
    placement_id INTEGER NOT NULL,
    PRIMARY KEY (board_brand, hole_id, product_size_id)
);

-- Placement → coordinate mapping (pre-joined from placements + holes)
CREATE TABLE placements (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    placement_id INTEGER NOT NULL,
    hole_id INTEGER NOT NULL,
    set_id INTEGER NOT NULL,
    x INTEGER NOT NULL,
    y INTEGER NOT NULL,
    PRIMARY KEY (board_brand, placement_id)
);

-- Board size definitions with edge boundaries for coordinate transformation
CREATE TABLE product_sizes (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    id INTEGER NOT NULL,
    product_id INTEGER NOT NULL,
    name TEXT NOT NULL,
    edge_left INTEGER NOT NULL,
    edge_right INTEGER NOT NULL,
    edge_bottom INTEGER NOT NULL,
    edge_top INTEGER NOT NULL,
    image_filename TEXT,
    PRIMARY KEY (board_brand, id)
);

-- Board images per size+layout+set combination
CREATE TABLE board_images (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    id INTEGER NOT NULL,
    product_size_id INTEGER NOT NULL,
    layout_id INTEGER NOT NULL,
    set_id INTEGER NOT NULL,
    image_filename TEXT NOT NULL,
    PRIMARY KEY (board_brand, id)
);

-- LED position per hole per board size
CREATE TABLE leds (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    hole_id INTEGER NOT NULL,
    product_size_id INTEGER NOT NULL,
    position INTEGER NOT NULL,
    PRIMARY KEY (board_brand, hole_id, product_size_id)
);

-- Raw hole coordinates (joined with placements to derive positions)
CREATE TABLE holes (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    id INTEGER NOT NULL,
    product_size_id INTEGER NOT NULL,
    x INTEGER NOT NULL,
    y INTEGER NOT NULL,
    mirrored_hole_id INTEGER,
    PRIMARY KEY (board_brand, id)
);

-- Per-board role → colour mapping (FEAT-031). Populated from a board's
-- catalogue when its chunk carries placement_roles; drives the LED + render
-- colours so each board uses its own scheme. `id` is the role value used in
-- climbs.frames (p{placement}r{id}); led_color/screen_color are hex strings.
CREATE TABLE placement_roles (
    board_brand TEXT NOT NULL DEFAULT 'kilter',
    id INTEGER NOT NULL,
    name TEXT,
    led_color TEXT,
    screen_color TEXT,
    PRIMARY KEY (board_brand, id)
);

CREATE INDEX idx_placements_set ON placements(board_brand, set_id);
CREATE INDEX idx_board_images_size ON board_images(board_brand, product_size_id);

CREATE TABLE sync_states (
    table_name TEXT NOT NULL PRIMARY KEY,
    last_synchronized_at TEXT NOT NULL
);

CREATE TABLE beta_links (
    id INTEGER NOT NULL PRIMARY KEY,
    climb_uuid TEXT NOT NULL,
    foreign_username TEXT,
    link TEXT NOT NULL,
    created_at TEXT
);

CREATE INDEX idx_beta_links_climb ON beta_links(climb_uuid);
CREATE INDEX idx_climb_stats_angle ON climb_stats(angle);
CREATE INDEX idx_climbs_listed ON climbs(is_listed);
-- All three climb_stats browse/count indexes lead with layout_id so a
-- query for one board (Kilter Original / Homewall / a MoonBoard variant)
-- seeks straight into its (layout_id, angle) slice instead of scanning the
-- `angle` bucket shared across every board's catalogue.
CREATE INDEX idx_climb_stats_browse ON climb_stats(
    layout_id, angle, difficulty_average, quality_average, ascensionist_count,
    benchmark_difficulty, climb_uuid
);
-- Optimized for default sort (ASCENSIONISTS DESC): (layout_id, angle) equality
-- + sort column lets SQLite scan backward without temp sort for LIMIT queries.
CREATE INDEX idx_climb_stats_by_popularity ON climb_stats(
    layout_id, angle, ascensionist_count, difficulty_average, climb_uuid
);
CREATE INDEX idx_climbs_frames_count ON climbs(is_listed, frames_count, uuid);

-- Covering index for COUNT queries: (layout_id, angle) equality → range
-- filters → climb_uuid for JOIN.
CREATE INDEX idx_climb_stats_count_cover ON climb_stats(
    layout_id, angle, ascensionist_count, difficulty_average, benchmark_difficulty, climb_uuid
);

-- FEAT-003 community-climb indexes
CREATE INDEX idx_climbs_source ON climbs(source);
CREATE INDEX idx_climbs_frames_hash ON climbs(frames_hash);
CREATE INDEX idx_climbs_pubkey ON climbs(created_by_pubkey);
CREATE INDEX idx_climbs_origin ON climbs(origin);
CREATE INDEX idx_climbs_kilter_status ON climbs(kilter_status);
CREATE INDEX idx_climbs_nostr_via ON climbs(nostr_publish_via);
CREATE INDEX idx_climbs_board_brand ON climbs(board_brand);

-- FEAT-006 Kilter publish per-attempt audit trail. Augments the
-- single-value `climbs.kilter_*` columns (which carry latest-status only)
-- with a permanent timeline so support / forensics / future retry caps
-- can reconstruct the attempt sequence. Rows are append-only; deleting
-- a climb intentionally does NOT cascade so the audit history survives.
CREATE TABLE kilter_publish_attempts (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    climb_uuid TEXT NOT NULL,
    attempted_at INTEGER NOT NULL,    -- wall-clock millis
    op TEXT NOT NULL,                 -- 'create' | 'update'
    via TEXT NOT NULL,                -- 'self' | 'cruxcoach'
    outcome TEXT NOT NULL,            -- 'success' | 'transient' | 'permanent' | 'rate_limited' | 'auth' | 'skipped'
    http_code INTEGER,                -- NULL when no HTTP round-trip happened
    error_excerpt TEXT                -- bounded by KilterApiClient.MAX_ERR_BODY at the boundary
);

CREATE INDEX idx_kilter_attempts_climb ON kilter_publish_attempts(climb_uuid, attempted_at DESC);

-- FEAT-003 grade consensus cache. MVP only stores setter_grade_id; full
-- consensus aggregation (vote_count, confidence, trimmed mean) lands when
-- public ascent-vote events ship in 0.2.0.
CREATE TABLE community_grade_cache (
    climb_d_tag TEXT NOT NULL,
    angle INTEGER NOT NULL,
    setter_grade_id INTEGER,
    consensus_average REAL,
    consensus_grade_id INTEGER,
    vote_count INTEGER NOT NULL DEFAULT 0,
    confidence TEXT NOT NULL DEFAULT 'LOW',
    last_updated INTEGER NOT NULL,
    PRIMARY KEY (climb_d_tag, angle)
);

-- Browse VIEW: live join of climb + stats, no frames column (saves ~50MB).
-- SQLite flattens simple INNER JOIN views into the outer query (no materialization).
CREATE VIEW climb_browse AS
SELECT
    c.uuid, c.name, c.setter_username, c.frames_count, cs.layout_id,
    c.board_brand,
    COALESCE(c.description, '') AS description,
    c.is_nomatch, c.frames_pace, c.hsm, c.move_count,
    c.source, c.created_by_pubkey, c.sync_status, c.origin, c.kilter_status,
    cs.angle, cs.difficulty_average, cs.quality_average,
    cs.ascensionist_count, cs.benchmark_difficulty
FROM climbs c
INNER JOIN climb_stats cs ON c.uuid = cs.climb_uuid
WHERE c.is_listed = 1;

-- Queries

-- Existence probe used by [upsertClimb] (the Kotlin-side transaction).
existsClimb:
SELECT 1 FROM climbs WHERE uuid = ? LIMIT 1;

-- Returns the local row's `created_at` for stale-event protection in
-- the Nostr live subscriber. Used to avoid letting a re-broadcasted
-- old event overwrite a newer state.
getClimbCreatedAt:
SELECT created_at FROM climbs WHERE uuid = ? LIMIT 1;

-- Returns the local row's `created_by_pubkey` so the live subscriber can
-- reject incoming Kind-30078 events whose signed pubkey differs from
-- whoever already owns this uuid. Without this guard a second author
-- with a colliding uuid silently overwrites the first author's row
-- (INSERT OR REPLACE keyed on uuid alone).
getClimbAuthorPubkey:
SELECT created_by_pubkey FROM climbs WHERE uuid = ? LIMIT 1;

-- True iff a row already exists for this uuid that is NOT a genuine community
-- climb: catalogue content (kilter/boardsesh) or any NULL-author row. A real
-- community row has BOTH origin='cruxcoach' AND a non-NULL created_by_pubkey.
-- getClimbAuthorPubkey returns NULL both for "no row" and for a catalogue row
-- with no author, so the cross-author guard treats a catalogue climb as
-- claimable; this lets the live subscriber explicitly reject an incoming
-- community Kind-30078 that tries to re-key/overwrite official catalogue content.
isNonCommunityClimb:
SELECT 1 FROM climbs
WHERE uuid = :uuid
  AND (origin IS NULL OR origin != 'cruxcoach' OR created_by_pubkey IS NULL)
LIMIT 1;

-- Backstop self-filter for the live subscriber. True iff a row exists
-- with source='local' — by definition only the editor's `insertLocalDraft`
-- writes that source value, so any uuid in this state was authored locally.
-- Used after the primary pubkey-based self-filter so a degraded signer
-- (ownPubkey resolution returning null) or a key rotation (where the
-- signed event still carries the old pubkey but the local user now
-- presents a new one) can't open the door for an own-event echo to
-- clobber `sync_status`, `kilter_status`, `nostr_event_id`, etc. via
-- upsertCommunityClimb's INSERT OR REPLACE.
isLocallyAuthored:
SELECT 1 FROM climbs WHERE uuid = ? AND source = 'local' LIMIT 1;

-- Insert-only path: used by the upsert transaction when no row with
-- this uuid exists. Default column values cover source ('kilter'),
-- origin ('kilter'), and the Nostr/Kilter status fields (NULL).
insertClimbRow:
INSERT INTO climbs(uuid, layout_id, setter_username, name,
    frames_count, is_listed, edge_left, edge_right, edge_bottom, edge_top, created_at,
    description, is_nomatch, frames_pace, hsm, frames, move_count)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update-only path: refreshes the columns Kilter is authoritative for
-- (name, frames, edges, …). Intentionally does NOT touch the CruxCoach
-- side: source, origin, nostr_event_id, nostr_d_tag, created_by_pubkey,
-- frames_hash, sync_status, kilter_status, kilter_synced_at,
-- kilter_publish_via, kilter_error. A CruxCoach-published climb that
-- got pulled back via the Kilter API harvest keeps its provenance +
-- Nostr linkage + Kilter publish status across blob refreshes.
updateClimbBlobFields:
UPDATE climbs SET
    layout_id = ?,
    setter_username = ?,
    name = ?,
    frames_count = ?,
    is_listed = ?,
    edge_left = ?,
    edge_right = ?,
    edge_bottom = ?,
    edge_top = ?,
    created_at = ?,
    description = ?,
    is_nomatch = ?,
    frames_pace = ?,
    hsm = ?,
    frames = ?,
    move_count = ?
WHERE uuid = ?;

-- Records the Kilter author identity (the climb author's Kilter userUuid)
-- on a board-DB row. The own-Kilter-climb publish gate compares this
-- against the connected account's userUuid — a reliable identity check,
-- never a display-name match. Fill-only: an already-recorded author is
-- never overwritten — the authored backfill marks PRE-EXISTING curated
-- rows too (resolved to their canonical stored uuid first), so re-runs
-- must not clobber a value another path recorded. Callers pass the
-- CANONICAL stored uuid (see findClimbCanonicalUuid) — this is an exact,
-- indexed match.
setClimbKilterAuthorUuid:
UPDATE climbs SET kilter_author_uuid = :authorUuid
WHERE uuid = :uuid AND kilter_author_uuid IS NULL;

-- The recorded Kilter author identity for a row (NULL = author unknown →
-- never publishable-as-mine). The publish gate compares this against the
-- CONNECTED account's userUuid — identity, never display name.
getClimbKilterAuthorUuid:
SELECT kilter_author_uuid FROM climbs WHERE uuid = :uuid LIMIT 1;

-- All climbs authored by the given Kilter user (the "Meine Climbs" list +
-- the logbook publish gate). Tombstoned rows are excluded; unlisted rows
-- are NOT (an own unlisted climb is still the user's work and publishable).
getOwnAuthoredKilterClimbs:
SELECT * FROM climbs
WHERE kilter_author_uuid = :authorUuid
  AND is_deleted = 0
ORDER BY created_at DESC;

-- Single-row variant of the above for the publish path: resolves the row
-- AND enforces the authorship gate in one indexed lookup. Returns nothing
-- when the row exists but was authored by someone else (or by an unknown
-- author) — the caller maps that to "not publishable".
getOwnAuthoredClimbRow:
SELECT * FROM climbs
WHERE uuid = :uuid
  AND kilter_author_uuid = :authorUuid
  AND is_deleted = 0
LIMIT 1;

-- Convert an own-authored Kilter row IN PLACE into a CruxCoach community
-- climb (FEAT: publish own Kilter climbs). IDENTITY DECISION: the climb
-- KEEPS its Kilter uuid — no new uuid is minted — so a future curated
-- import of the same climb reconciles onto this row instead of duplicating.
--
-- Provenance flips to what insertLocalDraft would have produced
-- (origin='cruxcoach', source='local', sync_status='draft',
-- created_by_pubkey=:pubkey), which makes the row eligible for
-- markClimbPublishInFlight / markClimbPublishedNostr and — on a relay
-- outage — for the CommunityPublishRetryWorker queue, all unchanged.
--
-- kilter_status is stamped 'synced' (+ kilter_synced_at): the climb is
-- ALREADY on Kilter natively (the user authored it there), so the
-- publisher's best-effort Kilter leg must see an occupied slot and skip —
-- re-creating the user's own climb on Kilter would be a duplicate write.
--
-- Guards, all at the SQL boundary:
--  * kilter_author_uuid = :kilterAuthorUuid — the caller passes the
--    CONNECTED account's userUuid; an unknown-author (curated) or
--    foreign-authored row never matches.
--  * created_by_pubkey IS NULL OR = :pubkey — cannot hijack a row already
--    owned by a different Nostr identity.
--  * nostr_event_id IS NULL — once published the conversion is moot;
--    refusing keeps a stray retry from resetting a published row to
--    'draft'. (A failed publish leaves nostr_event_id NULL, so retries
--    still pass.)
adoptKilterClimbAsCommunity:
UPDATE climbs SET
    origin = 'cruxcoach',
    source = 'local',
    sync_status = 'draft',
    created_by_pubkey = :pubkey,
    kilter_status = 'synced',
    kilter_synced_at = :adoptedAtEpochSeconds
WHERE uuid = :uuid
  AND kilter_author_uuid = :kilterAuthorUuid
  AND nostr_event_id IS NULL
  AND (created_by_pubkey IS NULL OR created_by_pubkey = :pubkey);

-- layout_id is denormalized from the owning climbs row (single source of
-- truth) so community-ingested + restored stats rows are visible to the
-- layout-scoped browse/count queries. Reusing the named :climb_uuid keeps
-- the generated signature identical to the old all-positional form, so no
-- caller changes. COALESCE → 0 if the climb row isn't present yet.
upsertClimbStat:
INSERT OR REPLACE INTO climb_stats(climb_uuid, angle, display_difficulty,
    difficulty_average, quality_average, ascensionist_count, benchmark_difficulty,
    fa_username, fa_at, official_kilter_difficulty, layout_id)
VALUES (:climb_uuid, ?, ?, ?, ?, ?, ?, ?, ?, ?,
    COALESCE((SELECT layout_id FROM climbs WHERE uuid = :climb_uuid), 0));

upsertHoldPosition:
INSERT OR REPLACE INTO board_hold_positions(board_brand, hole_id, product_size_id, x, y, led_position, placement_id)
VALUES (?, ?, ?, ?, ?, ?, ?);

upsertSyncState:
INSERT OR REPLACE INTO sync_states(table_name, last_synchronized_at) VALUES (?, ?);

getSyncState:
SELECT last_synchronized_at FROM sync_states WHERE table_name = ?;

-- ═══ Browse queries (climb_browse VIEW — JOIN flattened by SQLite) ═══
--
-- Always-on "fits my board" filter, two independent predicates per query:
--
--  1. Edge containment: `:selProductSizeId <= 0 OR EXISTS (...)` — the
--     climb's bounding box fits the selected product size. 0 = filter off.
--     STRICT `<`/`>` (not `<=`/`>=`) for official Kilter/Aurora parity: a
--     size's mounting frame edges sit ~1 grid unit beyond its outermost
--     actually-mounted holes, so a climb whose bbox edge EQUALS the frame
--     edge uses a boundary hole that isn't mounted on this (smaller) size —
--     it would render floating off the row. Strict excludes those.
--     (The render-target queries canRenderClimbOnSize / getProductSizeForClimbRender
--     below keep inclusive `<=`/`>=` — picking which size to draw on is a
--     containment question, not a list-membership one.)
--
--  2. Hold-set availability: `(hsm & :hsmExcludedMask) = 0`. climbs.hsm is a
--     BITMASK of the hold sets a climb uses; the bit index of a set is the
--     RANK of its set_id within the layout's distinct set ids sorted
--     ascending (verified against the Tension RE DB 5000/5000 + the Kilter
--     chunk: TB2 sets {8,9,10,11} → set 8 = bit0 … 11 = bit3; a climb on
--     sets {8,11} carries hsm 9). :hsmExcludedMask carries the bits of the
--     layout's sets NOT mounted on the user's selected size (computed in
--     Kotlin, see HoldSetMask). Mask 0 = filter off. hsm = 0 means UNKNOWN
--     (~10% of Kilter rows, all MoonBoard rows) and passes for free —
--     `(0 & mask) = 0` — so the filter stays lenient on unknown data.
--
-- The board-scoped list queries (getClimbsByUuidsForBoard etc.) deliberately
-- do NOT carry the hsm predicate: their Kilter fit-exception spans OTHER
-- layouts, and the mask's rank mapping is only valid within ONE layout.
--
-- Grade predicate + `:showUngraded`: Aurora boards ship zero-ascent catalogue
-- climbs as climb_stats stubs at the setter's angle with difficulty_average
-- NULL (quality NULL, ascensionist_count 0). A bare
-- `difficulty_average >= :minDiff AND <= :maxDiff` silently drops those NULL
-- rows, so every grade predicate is
--   ((difficulty_average BETWEEN bounds) OR (:showUngraded = 1 AND ... IS NULL)).
-- VM policy (product decision 2026-06-11): normal browse passes showUngraded=0
-- regardless of the slider — ungraded climbs never appear. The dedicated
-- "ungraded only (projects)" mode passes showUngraded=1 together with an
-- IMPOSSIBLE range (minDiff > maxDiff), so only the IS NULL leg can match and
-- the list shows exactly the ungraded climbs. (The BoardSesh provenance pull
-- below passes showUngraded=1 unconditionally — its imports are inherently
-- ungraded and the origin chip is the explicit opt-in.)
-- Sorting: NULL sorts as smallest in SQLite, so DESC orders already
-- trail ungraded rows; the ASC variants of the two NULL-able sort keys
-- (quality_average / difficulty_average) carry an explicit `IS NULL` tiebreak
-- so ungraded rows trail there too instead of flooding page 1.

browseByQualityDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY quality_average DESC LIMIT :limit OFFSET :offset;

browseByQualityAsc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY quality_average IS NULL, quality_average ASC LIMIT :limit OFFSET :offset;

browseByDifficultyDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY difficulty_average DESC LIMIT :limit OFFSET :offset;

browseByDifficultyAsc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY difficulty_average IS NULL, difficulty_average ASC LIMIT :limit OFFSET :offset;

browseByAscensionistsDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY ascensionist_count DESC LIMIT :limit OFFSET :offset;

browseByAscensionistsAsc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY ascensionist_count ASC LIMIT :limit OFFSET :offset;

-- Browse query restricted to CruxCoach-side climbs (community-published
-- + user's local drafts). Returns the FULL filtered set in one go —
-- no pagination — because the cruxcoach-side row count is tiny next
-- to the 190K Kilter catalogue. The previous pagination + client-side
-- OriginFilter combo silently buried community climbs without sends
-- at the bottom of the unsorted-by-origin pages: a freshly published
-- climb with quality_average=NULL sat past page 100 of the
-- quality-DESC sort, effectively invisible. Sorting is done in
-- Kotlin (matches `sortInKotlin`'s existing handling) so the
-- ascending / descending toggles all four sort fields without 4×
-- new SQL variants here.
--
-- Mirror the pre-existing browse WHERE clause exactly so
-- (layout, angle, grade range, ascensionist floor) filters land
-- on the same rows the unconstrained query would have. The single
-- added clause is `(origin = 'cruxcoach' OR source = 'local')` —
-- same predicate the client-side BrowserOriginFilter used.
browseCruxCoachOnly:
SELECT * FROM climb_browse
WHERE layout_id = :layoutId
  AND board_brand = :boardBrand
  AND angle = :angle
  AND frames_count >= :minFrames AND frames_count <= :maxFrames
  AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff)
       OR (:showUngraded = 1 AND difficulty_average IS NULL))
  AND COALESCE(ascensionist_count, 0) >= :minAsc
  AND (origin = 'cruxcoach' OR source = 'local')
  AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top))));

-- Browse query restricted to BoardSesh-imported climbs (origin='boardsesh').
-- Same shape and rationale as [browseCruxCoachOnly]: BoardSesh climbs carry
-- quality_average=NULL and ascensionist_count=0, so under the default
-- paginate-then-post-filter browse path they sort to the very bottom of the
-- 190K-row catalogue and never reach a visible page. Pull the entire
-- boardsesh set in one un-paginated SELECT (a couple hundred rows total) and
-- let the VM sort in Kotlin. The ONLY predicate difference from
-- browseCruxCoachOnly is `origin = 'boardsesh'` (no source='local' arm —
-- imported climbs are never local drafts).
browseBoardSeshOnly:
SELECT * FROM climb_browse
WHERE layout_id = :layoutId
  AND board_brand = :boardBrand
  AND angle = :angle
  AND frames_count >= :minFrames AND frames_count <= :maxFrames
  -- Same grade-range predicate as browseCruxCoachOnly and the default browse,
  -- INCLUDING the :showUngraded escape. Unlike the default browse, the VM
  -- passes showUngraded=1 here UNCONDITIONALLY: BoardSesh imports are
  -- inherently ungraded (difficulty_average NULL — 0-ascent user climbs with
  -- no consensus grade in ANY field, incl. test/scratch climbs), so selecting
  -- the BoardSesh origin chip is itself the explicit opt-in. Graded imports
  -- (all MoonBoard 2024, the ascended Kilter ones) still honour the slider's
  -- range leg.
  AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff)
       OR (:showUngraded = 1 AND difficulty_average IS NULL))
  AND COALESCE(ascensionist_count, 0) >= :minAsc
  AND origin = 'boardsesh'
  AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top))));

-- Angle-AGNOSTIC variants of the two community-provenance browses (Req-1): a
-- created/community climb is authored at ONE setter angle but is climbable at
-- EVERY angle of its board, so the provenance filters must surface it whatever
-- the angle slider reads. (Catalogue climbs carry their own per-angle rows, so
-- the default browse stays angle-specific; community climbs sort to the bottom
-- there anyway, which is why these dedicated provenance pulls exist.) These omit
-- the `angle = :angle` clause; the repo dedupes to one row per uuid, preferring
-- the active angle's grade row. Grade/size/frame filters are unchanged.
browseCruxCoachOnlyAnyAngle:
SELECT * FROM climb_browse
WHERE layout_id = :layoutId
  AND board_brand = :boardBrand
  AND frames_count >= :minFrames AND frames_count <= :maxFrames
  AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff)
       OR (:showUngraded = 1 AND difficulty_average IS NULL))
  AND COALESCE(ascensionist_count, 0) >= :minAsc
  AND (origin = 'cruxcoach' OR source = 'local')
  AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top))));

browseBoardSeshOnlyAnyAngle:
SELECT * FROM climb_browse
WHERE layout_id = :layoutId
  AND board_brand = :boardBrand
  AND frames_count >= :minFrames AND frames_count <= :maxFrames
  AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff)
       OR (:showUngraded = 1 AND difficulty_average IS NULL))
  AND COALESCE(ascensionist_count, 0) >= :minAsc
  AND origin = 'boardsesh'
  AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top))));

browseByNameDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY name DESC LIMIT :limit OFFSET :offset;

browseByNameAsc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY name ASC LIMIT :limit OFFSET :offset;

-- ORDER BY move_count. move_count = 0 means "not yet computed" (importer
-- backfills lazily), so those rows sort to the ASC top / DESC bottom rather
-- than by their true length. Acceptable: the backfill converges quickly.
browseByMovesDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY move_count DESC LIMIT :limit OFFSET :offset;

browseByMovesAsc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY move_count ASC LIMIT :limit OFFSET :offset;

-- ORDER BY sends × quality (popular AND well-rated). COALESCE so climbs
-- with NULL quality_average don't fall behind a 0-quality climb.
browseByQualitySendsDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY (ascensionist_count * COALESCE(quality_average, 0)) DESC LIMIT :limit OFFSET :offset;

browseByQualitySendsAsc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY (ascensionist_count * COALESCE(quality_average, 0)) ASC LIMIT :limit OFFSET :offset;

-- Random order over the filtered set. Pagination is independently random
-- per page (SQLite RANDOM() is non-deterministic across calls); scrolling
-- yields more random results rather than a stable shuffled list. Browse
-- mode bypasses this query via the VM's UUID-shuffle cache (see
-- [browseAllMatchingUuids]); only the search+random combo still hits it.
browseRandom:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY RANDOM() LIMIT :limit OFFSET :offset;

-- UUID-only projection of the entire browse-filter match set, no order
-- and no limit. Backs the Kotlin-side stable shuffle for RANDOM sort:
-- VM loads this once per filter signature, shuffles with a session
-- Random instance, then paginates over the cached list and looks up
-- climbs via getClimbsByUuids. Without this we'd have to rely on SQL
-- ORDER BY RANDOM(), which gives a fresh permutation per page query
-- and therefore duplicates+gaps when scrolling. The result set is just
-- 36-byte UUID strings; even an unfiltered Kilter catalog (~190K rows)
-- is ~7 MB — acceptable on a single load.
browseAllMatchingUuids:
SELECT uuid FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND ((difficulty_average >= :minDiff AND difficulty_average <= :maxDiff) OR (:showUngraded = 1 AND difficulty_average IS NULL)) AND COALESCE(ascensionist_count, 0) >= :minAsc AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top))));

-- ═══ Search queries (climb_browse VIEW — additional JOIN for repeat_count) ═══

searchByQualityDesc:
SELECT * FROM climb_browse WHERE layout_id = :layoutId AND board_brand = :boardBrand AND (name LIKE '%' || :query || '%' OR setter_username LIKE '%' || :query || '%') AND angle = :angle AND frames_count >= :minFrames AND frames_count <= :maxFrames AND (hsm & :hsmExcludedMask) = 0 AND (:selProductSizeId <= 0 OR EXISTS (SELECT 1 FROM product_sizes ps JOIN climbs c ON c.uuid = climb_browse.uuid WHERE ps.id = :selProductSizeId AND ps.board_brand = :boardBrand AND (c.edge_left IS NULL OR (ps.edge_left < c.edge_left AND ps.edge_right > c.edge_right AND ps.edge_bottom < c.edge_bottom AND ps.edge_top > c.edge_top)))) ORDER BY quality_average DESC LIMIT :limit OFFSET :offset;

