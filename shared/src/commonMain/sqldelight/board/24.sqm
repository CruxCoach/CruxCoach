-- Migration version 23 → 24: also surface climbs.created_at on the
-- climb_browse VIEW so the browser's "Newest" sort can ORDER BY it
-- directly (VIEW recreation only — no table or data change).
--
-- Merge reconciliation: on the 0.2.1 line this was 23.sqm, but 23.sqm on
-- the 0.2.2 line already belongs to FEAT-024 (nostr_event_id). Both
-- recreate this VIEW, so "Newest" moves to 24 and its CREATE VIEW
-- carries BOTH new columns (nostr_event_id from 23, created_at added
-- here) — otherwise the second migration would drop the first's column.
--
-- created_at is a TEXT passthrough in two shapes (catalogue
-- 'YYYY-MM-DD HH:MM:SS(.f)', community/local ISO-8601); lexicographic
-- order is date-correct across both.
--
-- This CREATE VIEW must stay byte-identical to the canonical definition
-- in Board.sq (verifyCommonMainBoardDatabaseMigration enforces it).
DROP VIEW IF EXISTS climb_browse;
CREATE VIEW climb_browse AS
SELECT
    c.uuid, c.name, c.setter_username, c.frames_count, cs.layout_id,
    c.board_brand,
    COALESCE(c.description, '') AS description,
    c.is_nomatch, c.frames_pace, c.hsm, c.move_count,
    c.source, c.created_by_pubkey, c.sync_status, c.origin, c.kilter_status,
    c.nostr_event_id,
    c.created_at,
    cs.angle, cs.difficulty_average, cs.quality_average,
    cs.ascensionist_count, cs.benchmark_difficulty
FROM climbs c
INNER JOIN climb_stats cs ON c.uuid = cs.climb_uuid
WHERE c.is_listed = 1;
