-- Migration version 22 → 23: surface climbs.nostr_event_id on the
-- climb_browse VIEW (FEAT-024 — unified publish-state signal).
--
-- The browser (ClimbCard "Entwurf"/draft badge) and the climb detail
-- screen must agree on ONE canonical "is this climb live on Nostr?"
-- signal. Detail already keys off climbs.nostr_event_id; the browser was
-- still inferring draft-ness from a 3-value sync_status allowlist
-- (NULL / 'draft' / 'failed') read through this VIEW, which omitted
-- nostr_event_id. Project it so both screens read the same column.
--
-- INVARIANT: a community/own climb is "published" IFF nostr_event_id IS
-- NOT NULL. Browser + detail must both key off this column — do not
-- re-derive publish state from sync_status. nostr_event_id comes from
-- climbs; the INNER JOIN already loads that row, so projecting one more
-- column is free (no new index needed).
--
-- This CREATE VIEW must stay byte-identical to the canonical definition
-- in Board.sq (verifyCommonMainBoardDatabaseMigration enforces it).
DROP VIEW IF EXISTS climb_browse;
CREATE VIEW climb_browse AS
SELECT
    c.uuid, c.name, c.setter_username, c.frames_count, cs.layout_id,
    c.board_brand,
    COALESCE(c.description, '') AS description,
    c.is_nomatch, c.frames_pace, c.hsm, c.move_count,
    c.source, c.created_by_pubkey, c.sync_status, c.origin, c.kilter_status,
    c.nostr_event_id,
    cs.angle, cs.difficulty_average, cs.quality_average,
    cs.ascensionist_count, cs.benchmark_difficulty
FROM climbs c
INNER JOIN climb_stats cs ON c.uuid = cs.climb_uuid
WHERE c.is_listed = 1;
