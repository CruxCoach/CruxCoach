-- Quantum catalogue routes use an app-local UUIDv5 so the same upstream
-- route can exist on several physical models without colliding in climbs.
-- Keep the upstream UUID separately: the 2.0.14 controller protocol sends
-- that original UUID as 16 raw bytes.
CREATE TABLE quantum_route_refs (
    app_uuid TEXT NOT NULL PRIMARY KEY,
    route_uuid TEXT NOT NULL,
    model TEXT NOT NULL,
    UNIQUE(route_uuid, model)
);

CREATE INDEX idx_quantum_route_refs_external
    ON quantum_route_refs(route_uuid, model);
