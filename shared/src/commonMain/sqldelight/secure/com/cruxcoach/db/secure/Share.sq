-- Personal-data sharing v3 ("who sees this?", FEAT-073): the owner's local,
-- unsigned policy, the state of each direction of the sync protocol, and
-- records received from friends. Protocol data (sessions, keys, delivery)
-- lives in the native host. Received records never enter canonical tables.
--
-- Category names are not CHECKed here: the catalogue is closed in code
-- (ShareCategory) and unknown names resolve to "not shared", so a later
-- category needs no table rebuild.

-- Templates replace the two circles of v2 (owner decision 2026-10-25). The
-- shipped rows are a starting point; a later edit is an upsert and is never
-- reset. Health data is never part of a template.
CREATE TABLE share_template (
    id TEXT NOT NULL PRIMARY KEY,
    categories TEXT NOT NULL,
    period_days INTEGER NOT NULL CHECK (period_days = -1 OR period_days > 0),
    hidden INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0, 1))
);

INSERT INTO share_template(id, categories, period_days, hidden) VALUES
    ('TRAINING_PARTNER', 'CLIMBING_PROFILE,SENDS,ATTEMPTS,CLIMB_NOTES', 30, 0),
    ('FAMILY', 'CLIMBING_PROFILE,WEEKLY_VOLUME', 30, 1),
    ('COACH', 'CLIMBING_PROFILE,SENDS,ATTEMPTS,CLIMB_NOTES', 365, 1);

-- Local settings of sharing itself (the self-declared age).
CREATE TABLE share_setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE share_person (
    peer TEXT NOT NULL PRIMARY KEY CHECK (length(peer) = 64),
    template TEXT NOT NULL,
    outgoing INTEGER NOT NULL CHECK (outgoing IN (0, 1)),
    period_days INTEGER CHECK (period_days IS NULL OR period_days = -1 OR period_days > 0),
    label TEXT,
    state TEXT NOT NULL CHECK (state IN ('REQUESTED', 'CONNECTED', 'ENDING', 'ENDED')),
    cancel_pending INTEGER NOT NULL DEFAULT 0 CHECK (cancel_pending IN (0, 1)),
    created_at INTEGER NOT NULL,
    ended_at INTEGER
);

CREATE TABLE share_person_rule (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    category TEXT NOT NULL,
    effect TEXT NOT NULL CHECK (effect IN ('ALLOW', 'DENY')),
    expires_at INTEGER,
    PRIMARY KEY (peer, category)
);

CREATE TABLE share_object_rule (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    category TEXT NOT NULL,
    effect TEXT NOT NULL CHECK (effect IN ('ALLOW', 'DENY')),
    expires_at INTEGER,
    PRIMARY KEY (peer, record_id)
);

-- "Never share this record": for every audience.
CREATE TABLE share_never (
    record_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL
);

-- Outgoing sync runs per stream, not per person: one stream
-- per audience, i.e. per set of people with the same effective rule. A stream
-- is computed once and goes to each member; 0.2.7 encrypts it once (Megolm).
-- Its id is random and travels only inside encrypted messages. A stream
-- without members is deleted.
CREATE TABLE share_stream (
    id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 32),
    kind TEXT NOT NULL CHECK (kind IN ('RULE', 'GROUP')),
    rule_key TEXT NOT NULL,
    generation INTEGER NOT NULL,
    sequence INTEGER NOT NULL,
    generation_started_at INTEGER NOT NULL,
    scope TEXT NOT NULL,
    digest TEXT NOT NULL,
    record_count INTEGER NOT NULL,
    manifest_at INTEGER NOT NULL,
    full_required INTEGER NOT NULL DEFAULT 0 CHECK (full_required IN (0, 1)),
    epoch INTEGER NOT NULL DEFAULT 0,
    pending_since INTEGER,
    created_at INTEGER NOT NULL,
    UNIQUE (kind, rule_key)
);

-- What a stream's members hold: one row per record sent, with its revision.
CREATE TABLE share_stream_sent (
    stream TEXT NOT NULL REFERENCES share_stream(id) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    PRIMARY KEY (stream, record_id)
);

-- A person is in at most one stream. assign counts the snapshots this person
-- was handed (it travels on the wire and only grows); snapshot_due asks for
-- the next one.
CREATE TABLE share_stream_member (
    peer TEXT NOT NULL PRIMARY KEY REFERENCES share_person(peer) ON DELETE CASCADE,
    stream TEXT NOT NULL REFERENCES share_stream(id),
    assign INTEGER NOT NULL DEFAULT 0,
    assigned_at INTEGER NOT NULL DEFAULT 0,
    snapshot_due INTEGER NOT NULL DEFAULT 1 CHECK (snapshot_due IN (0, 1)),
    acked_generation INTEGER NOT NULL DEFAULT 0,
    acked_sequence INTEGER NOT NULL DEFAULT -1,
    acked_at INTEGER NOT NULL DEFAULT 0,
    joined_at INTEGER NOT NULL
);

CREATE INDEX share_stream_member_stream ON share_stream_member(stream);

-- Per friend: the stream and snapshot (assign) we follow, the position in it,
-- where the full state being staged stands (base, staged_assign), and the
-- streams it replaced, whose late messages are dropped.
CREATE TABLE share_incoming (
    peer TEXT NOT NULL PRIMARY KEY REFERENCES share_person(peer) ON DELETE CASCADE,
    stream TEXT NOT NULL,
    assign INTEGER NOT NULL,
    generation INTEGER NOT NULL,
    sequence INTEGER NOT NULL,
    base INTEGER NOT NULL,
    staged_assign INTEGER NOT NULL,
    scope TEXT NOT NULL,
    expected_digest TEXT NOT NULL,
    expected_count INTEGER NOT NULL,
    staging TEXT NOT NULL,
    pending TEXT NOT NULL,
    gap_since INTEGER NOT NULL DEFAULT 0,
    resync_generation INTEGER NOT NULL DEFAULT 0,
    resync_at INTEGER NOT NULL DEFAULT 0,
    ack_due INTEGER NOT NULL DEFAULT 0,
    received_at INTEGER NOT NULL,
    retired TEXT NOT NULL
);

-- expires_at: the friend's grant for this record ends then; this app deletes
-- the record at that moment even if the friend is not in reach.
CREATE TABLE share_record (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    category TEXT NOT NULL,
    revision INTEGER NOT NULL,
    climb_uuid TEXT,
    occurred_on TEXT,
    fields TEXT NOT NULL,
    expires_at INTEGER,
    PRIMARY KEY (peer, record_id)
);

CREATE INDEX share_record_climb ON share_record(climb_uuid);

-- Local history of one's own sharing decisions (FEAT-073 U2): never sent,
-- never in a backup, at most a year and 1,000 entries.
CREATE TABLE share_history (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    at INTEGER NOT NULL,
    peer TEXT,
    event TEXT NOT NULL,
    detail TEXT
);

selectTemplates:
SELECT * FROM share_template ORDER BY rowid;

upsertTemplate:
INSERT OR REPLACE INTO share_template(id, categories, period_days, hidden) VALUES (?, ?, ?, ?);

selectSetting:
SELECT value FROM share_setting WHERE key = ?;

putSetting:
INSERT OR REPLACE INTO share_setting(key, value) VALUES (?, ?);

selectPersons:
SELECT * FROM share_person ORDER BY created_at, peer;

selectPerson:
SELECT * FROM share_person WHERE peer = ?;

insertPerson:
INSERT INTO share_person(peer, template, outgoing, period_days, label, state, cancel_pending, created_at, ended_at)
VALUES (?, ?, ?, ?, ?, ?, 0, ?, NULL);

updatePersonTemplate:
UPDATE share_person SET template = ? WHERE peer = ?;

updatePersonOutgoing:
UPDATE share_person SET outgoing = ? WHERE peer = ?;

updatePersonPeriod:
UPDATE share_person SET period_days = ? WHERE peer = ?;

updatePersonLabel:
UPDATE share_person SET label = ? WHERE peer = ?;

updatePersonState:
UPDATE share_person SET state = ?, ended_at = ? WHERE peer = ?;

setCancelPending:
UPDATE share_person SET cancel_pending = ? WHERE peer = ?;

deletePerson:
DELETE FROM share_person WHERE peer = ?;

-- Foreign keys stay off on the secure database (release tables declare
-- references the app never enforced), so removing a person deletes the
-- dependent rows explicitly in the same transaction (SharingStore.deletePerson).
deletePersonRules:
DELETE FROM share_person_rule WHERE peer = ?;

deletePersonObjectRules:
DELETE FROM share_object_rule WHERE peer = ?;

selectAllPersonRules:
SELECT * FROM share_person_rule;

upsertPersonRule:
INSERT OR REPLACE INTO share_person_rule(peer, category, effect, expires_at) VALUES (?, ?, ?, ?);

deletePersonRule:
DELETE FROM share_person_rule WHERE peer = ? AND category = ?;

selectAllObjectRules:
SELECT * FROM share_object_rule;

upsertObjectRule:
INSERT OR REPLACE INTO share_object_rule(peer, record_id, category, effect, expires_at) VALUES (?, ?, ?, ?, ?);

deleteObjectRule:
DELETE FROM share_object_rule WHERE peer = ? AND record_id = ?;

selectNever:
SELECT record_id FROM share_never ORDER BY record_id;

insertNever:
INSERT OR REPLACE INTO share_never(record_id, created_at) VALUES (?, ?);

deleteNever:
DELETE FROM share_never WHERE record_id = ?;

selectStreams:
SELECT * FROM share_stream ORDER BY created_at, id;

selectStream:
SELECT * FROM share_stream WHERE id = ?;

selectStreamByKey:
SELECT * FROM share_stream WHERE kind = ? AND rule_key = ?;

upsertStream:
INSERT OR REPLACE INTO share_stream(id, kind, rule_key, generation, sequence, generation_started_at, scope, digest,
    record_count, manifest_at, full_required, epoch, pending_since, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Foreign keys are off (see deletePersonRules): a stream's rows go explicitly.
deleteEmptyStreamsSent:
DELETE FROM share_stream_sent WHERE stream NOT IN (SELECT stream FROM share_stream_member);

deleteEmptyStreams:
DELETE FROM share_stream WHERE id NOT IN (SELECT stream FROM share_stream_member);

selectSent:
SELECT record_id, revision FROM share_stream_sent WHERE stream = ?;

upsertSent:
INSERT OR REPLACE INTO share_stream_sent(stream, record_id, revision) VALUES (?, ?, ?);

deleteSent:
DELETE FROM share_stream_sent WHERE stream = ? AND record_id = ?;

deleteAllSent:
DELETE FROM share_stream_sent WHERE stream = ?;

selectMembers:
SELECT * FROM share_stream_member ORDER BY joined_at, peer;

selectMember:
SELECT * FROM share_stream_member WHERE peer = ?;

selectStreamMembers:
SELECT * FROM share_stream_member WHERE stream = ? ORDER BY joined_at, peer;

upsertMember:
INSERT OR REPLACE INTO share_stream_member(peer, stream, assign, assigned_at, snapshot_due, acked_generation,
    acked_sequence, acked_at, joined_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

requireSnapshot:
UPDATE share_stream_member SET snapshot_due = 1 WHERE peer = ?;

recordAck:
UPDATE share_stream_member SET acked_generation = ?, acked_sequence = ?, acked_at = ? WHERE peer = ?;

deleteMember:
DELETE FROM share_stream_member WHERE peer = ?;

selectIncoming:
SELECT * FROM share_incoming WHERE peer = ?;

selectAllIncoming:
SELECT * FROM share_incoming;

upsertIncoming:
INSERT OR REPLACE INTO share_incoming(peer, stream, assign, generation, sequence, base, staged_assign, scope,
    expected_digest, expected_count, staging, pending, gap_since, resync_generation, resync_at, ack_due, received_at, retired)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteIncoming:
DELETE FROM share_incoming WHERE peer = ?;

selectRecords:
SELECT * FROM share_record WHERE peer = ? ORDER BY record_id;

selectAllRecords:
SELECT * FROM share_record ORDER BY peer, record_id;

selectRecordsForClimb:
SELECT * FROM share_record WHERE climb_uuid = ? ORDER BY peer, occurred_on DESC, record_id;

countRecords:
SELECT count(*) FROM share_record WHERE peer = ?;

upsertRecord:
INSERT OR REPLACE INTO share_record(peer, record_id, category, revision, climb_uuid, occurred_on, fields, expires_at)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

deleteRecord:
DELETE FROM share_record WHERE peer = ? AND record_id = ?;

deleteRecords:
DELETE FROM share_record WHERE peer = ?;

-- Expiry (FEAT-073 AC-6): received records end at their expires_at (plus a
-- small grace for clock skew), own rules end at theirs.
deleteExpiredRecords:
DELETE FROM share_record WHERE expires_at IS NOT NULL AND expires_at <= ?;

selectRecordExpiries:
SELECT expires_at FROM share_record WHERE expires_at IS NOT NULL;

selectExpiredRulePeers:
SELECT peer FROM share_person_rule WHERE expires_at IS NOT NULL AND expires_at <= :now
UNION SELECT peer FROM share_object_rule WHERE expires_at IS NOT NULL AND expires_at <= :now;

deleteExpiredPersonRules:
DELETE FROM share_person_rule WHERE expires_at IS NOT NULL AND expires_at <= ?;

deleteExpiredObjectRules:
DELETE FROM share_object_rule WHERE expires_at IS NOT NULL AND expires_at <= ?;

insertHistory:
INSERT INTO share_history(at, peer, event, detail) VALUES (?, ?, ?, ?);

pruneHistory:
DELETE FROM share_history WHERE at < :horizon OR seq <= (SELECT max(seq) FROM share_history) - :keep;

selectHistory:
SELECT * FROM share_history ORDER BY seq DESC LIMIT :limit;

selectRuleExpiries:
SELECT expires_at FROM share_person_rule WHERE expires_at IS NOT NULL
UNION ALL SELECT expires_at FROM share_object_rule WHERE expires_at IS NOT NULL;
