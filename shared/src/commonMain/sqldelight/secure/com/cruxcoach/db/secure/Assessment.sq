CREATE TABLE Assessment (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    user_id INTEGER NOT NULL,
    date TEXT NOT NULL,
    max_hang_20mm_kg REAL,
    max_hang_pct_bw REAL,
    weighted_pullup_kg REAL,
    pullup_max_reps INTEGER,
    push_up_max_reps INTEGER,
    core_hold_sec INTEGER,
    flexibility_score INTEGER DEFAULT 3,
    board_import_summary TEXT,
    notes TEXT,
    FOREIGN KEY (user_id) REFERENCES UserProfile(id)
);

insert:
INSERT INTO Assessment (user_id, date, max_hang_20mm_kg, max_hang_pct_bw,
    weighted_pullup_kg, pullup_max_reps, push_up_max_reps,
    core_hold_sec, flexibility_score, board_import_summary, notes)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

getById:
SELECT * FROM Assessment WHERE id = ?;

getLatestForUser:
SELECT * FROM Assessment WHERE user_id = ? ORDER BY date DESC LIMIT 1;

getAllForUser:
SELECT * FROM Assessment WHERE user_id = ? ORDER BY date DESC;

lastInsertRowId:
SELECT last_insert_rowid();

deleteById:
DELETE FROM Assessment WHERE id = ?;
