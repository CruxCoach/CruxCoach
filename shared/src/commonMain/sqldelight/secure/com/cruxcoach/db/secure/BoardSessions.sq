-- Board training session tracking — private, per-key DB file

CREATE TABLE board_sessions (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    started_at TEXT NOT NULL,
    ended_at TEXT,
    total_duration_seconds INTEGER NOT NULL DEFAULT 0,
    pause_duration_seconds INTEGER NOT NULL DEFAULT 0,
    ascent_count INTEGER NOT NULL DEFAULT 0,
    bid_count INTEGER NOT NULL DEFAULT 0
);

-- ═══ Queries ═══

insertBoardSession:
INSERT INTO board_sessions(started_at, ended_at, total_duration_seconds, pause_duration_seconds, ascent_count, bid_count)
VALUES (?, ?, ?, ?, ?, ?);

getLastInsertedSessionId:
SELECT last_insert_rowid();

getRecentBoardSessions:
SELECT * FROM board_sessions WHERE ended_at IS NOT NULL ORDER BY started_at DESC LIMIT ?;

getActiveSession:
SELECT * FROM board_sessions WHERE ended_at IS NULL ORDER BY started_at DESC LIMIT 1;

updateActiveSession:
UPDATE board_sessions
SET ascent_count = ?, bid_count = ?, pause_duration_seconds = ?, total_duration_seconds = ?
WHERE id = ?;

endBoardSession:
UPDATE board_sessions SET ended_at = ?, total_duration_seconds = ?, pause_duration_seconds = ?, ascent_count = ?, bid_count = ?
WHERE id = ?;

-- ═══ Export ═══

getAllBoardSessions:
SELECT * FROM board_sessions ORDER BY started_at DESC;

-- ═══ Bulk operations ═══

-- Sessions are aggregate counters (durations + ascent/bid counts) with
-- no climb or board reference, so they cannot be scoped per board: the
-- per-board "Delete logbook data" path keeps them and only the
-- all-boards selection wipes them via this query.
deleteAllBoardSessions:
DELETE FROM board_sessions;
