-- Board training session tracking — private, per-key DB file

CREATE TABLE board_session (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    started_at TEXT NOT NULL,
    ended_at TEXT,
    total_duration_seconds INTEGER NOT NULL DEFAULT 0,
    pause_duration_seconds INTEGER NOT NULL DEFAULT 0,
    ascent_count INTEGER NOT NULL DEFAULT 0,
    bid_count INTEGER NOT NULL DEFAULT 0
);

-- ═══ Queries ═══

insertBoardSession:
INSERT INTO board_session(started_at, ended_at, total_duration_seconds, pause_duration_seconds, ascent_count, bid_count)
VALUES (?, ?, ?, ?, ?, ?);

getLastInsertedSessionId:
SELECT last_insert_rowid();

getRecentBoardSessions:
SELECT * FROM board_session WHERE ended_at IS NOT NULL ORDER BY started_at DESC LIMIT ?;

getActiveSession:
SELECT * FROM board_session WHERE ended_at IS NULL ORDER BY started_at DESC LIMIT 1;

updateActiveSession:
UPDATE board_session
SET ascent_count = ?, bid_count = ?, pause_duration_seconds = ?, total_duration_seconds = ?
WHERE id = ?;

endBoardSession:
UPDATE board_session SET ended_at = ?, total_duration_seconds = ?, pause_duration_seconds = ?, ascent_count = ?, bid_count = ?
WHERE id = ?;

-- ═══ Export ═══

getAllBoardSessions:
SELECT * FROM board_session ORDER BY started_at DESC;

-- ═══ Bulk operations ═══

deleteAllBoardSessions:
DELETE FROM board_session;
