CREATE TABLE TrainingSession (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    plan_id INTEGER NOT NULL,
    day_of_week INTEGER NOT NULL,
    session_type TEXT NOT NULL,
    exercises TEXT NOT NULL,
    target_duration_min INTEGER NOT NULL,
    target_rpe REAL NOT NULL,
    notes TEXT,
    FOREIGN KEY (plan_id) REFERENCES TrainingPlan(id)
);

insert:
INSERT INTO TrainingSession (plan_id, day_of_week, session_type,
    exercises, target_duration_min, target_rpe, notes)
VALUES (?, ?, ?, ?, ?, ?, ?);

getById:
SELECT * FROM TrainingSession WHERE id = ?;

getForPlan:
SELECT * FROM TrainingSession WHERE plan_id = ? ORDER BY day_of_week;

getForPlanAndDay:
SELECT * FROM TrainingSession WHERE plan_id = ? AND day_of_week = ?;

lastInsertRowId:
SELECT last_insert_rowid();

deleteForPlan:
DELETE FROM TrainingSession WHERE plan_id = ?;
