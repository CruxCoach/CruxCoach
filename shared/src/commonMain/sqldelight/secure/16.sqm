-- Migration 16 → 17 (secure/personal DB): personal-data sharing v3
-- ("who sees this?", FEAT-073), carried from feat/marmot-permissions-v2 onto
-- the 0.2.4 release line and reshaped before its first release.
--
-- Purely additive: twelve tables, empty except for the shipped templates; no existing
-- table, row or trigger is touched, and nothing writes to these tables until
-- someone is invited. The release line never carried the unpublished feature
-- migrations 14–33 of that branch (its 14/15 are different tables), so nothing
-- of v1 or v2 is dropped or reinterpreted here. The DDL is kept identical to
-- Share.sq so a migrated and a fresh database have the same shape
-- (SharingProjectionSchemaTest).


-- Templates replace the two circles of v2 (owner decision 2026-10-25). The
-- shipped rows are a starting point; a later edit is an upsert and is never
-- reset. Health data is never part of a template.
CREATE TABLE share_template (
    id TEXT NOT NULL PRIMARY KEY,
    categories TEXT NOT NULL,
    period_days INTEGER NOT NULL CHECK (period_days = -1 OR period_days > 0),
    hidden INTEGER NOT NULL DEFAULT 0 CHECK (hidden IN (0, 1))
);

INSERT INTO share_template(id, categories, period_days, hidden) VALUES
    ('TRAINING_PARTNER', 'CLIMBING_PROFILE,SENDS,ATTEMPTS,CLIMB_NOTES', 30, 0),
    ('FAMILY', 'CLIMBING_PROFILE,WEEKLY_VOLUME', 30, 1),
    ('COACH', 'CLIMBING_PROFILE,SENDS,ATTEMPTS,CLIMB_NOTES', 365, 1);

-- Local settings of sharing itself (the self-declared age).
CREATE TABLE share_setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE TABLE share_person (
    peer TEXT NOT NULL PRIMARY KEY CHECK (length(peer) = 64),
    template TEXT NOT NULL,
    outgoing INTEGER NOT NULL CHECK (outgoing IN (0, 1)),
    period_days INTEGER CHECK (period_days IS NULL OR period_days = -1 OR period_days > 0),
    label TEXT,
    state TEXT NOT NULL CHECK (state IN ('REQUESTED', 'CONNECTED', 'ENDING', 'ENDED')),
    cancel_pending INTEGER NOT NULL DEFAULT 0 CHECK (cancel_pending IN (0, 1)),
    created_at INTEGER NOT NULL,
    ended_at INTEGER
);

CREATE TABLE share_person_rule (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    category TEXT NOT NULL,
    effect TEXT NOT NULL CHECK (effect IN ('ALLOW', 'DENY')),
    expires_at INTEGER,
    PRIMARY KEY (peer, category)
);

CREATE TABLE share_object_rule (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    category TEXT NOT NULL,
    effect TEXT NOT NULL CHECK (effect IN ('ALLOW', 'DENY')),
    expires_at INTEGER,
    PRIMARY KEY (peer, record_id)
);

-- "Never share this record": for every audience.
CREATE TABLE share_never (
    record_id TEXT NOT NULL PRIMARY KEY,
    created_at INTEGER NOT NULL
);

-- Outgoing sync runs per stream, not per person: one stream
-- per audience, i.e. per set of people with the same effective rule. A stream
-- is computed once and goes to each member; 0.2.7 encrypts it once (Megolm).
-- Its id is random and travels only inside encrypted messages. A stream
-- without members is deleted. pending_*: growth held back to send it as one
-- delta (since when, last change, the digest it had then).
CREATE TABLE share_stream (
    id TEXT NOT NULL PRIMARY KEY CHECK (length(id) = 32),
    kind TEXT NOT NULL CHECK (kind IN ('RULE', 'GROUP')),
    rule_key TEXT NOT NULL,
    generation INTEGER NOT NULL,
    sequence INTEGER NOT NULL,
    generation_started_at INTEGER NOT NULL,
    scope TEXT NOT NULL,
    digest TEXT NOT NULL,
    record_count INTEGER NOT NULL,
    manifest_at INTEGER NOT NULL,
    full_required INTEGER NOT NULL DEFAULT 0 CHECK (full_required IN (0, 1)),
    epoch INTEGER NOT NULL DEFAULT 0,
    pending_since INTEGER,
    pending_at INTEGER,
    pending_digest TEXT,
    created_at INTEGER NOT NULL,
    UNIQUE (kind, rule_key)
);

-- What a stream's members hold: one row per record sent, with its revision.
CREATE TABLE share_stream_sent (
    stream TEXT NOT NULL REFERENCES share_stream(id) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    revision INTEGER NOT NULL,
    PRIMARY KEY (stream, record_id)
);

-- A person is in at most one stream. assign counts the snapshots this person
-- was handed (it travels on the wire and only grows); snapshot_due asks for
-- the next one.
CREATE TABLE share_stream_member (
    peer TEXT NOT NULL PRIMARY KEY REFERENCES share_person(peer) ON DELETE CASCADE,
    stream TEXT NOT NULL REFERENCES share_stream(id),
    assign INTEGER NOT NULL DEFAULT 0,
    assigned_at INTEGER NOT NULL DEFAULT 0,
    snapshot_due INTEGER NOT NULL DEFAULT 1 CHECK (snapshot_due IN (0, 1)),
    acked_generation INTEGER NOT NULL DEFAULT 0,
    acked_sequence INTEGER NOT NULL DEFAULT -1,
    acked_at INTEGER NOT NULL DEFAULT 0,
    joined_at INTEGER NOT NULL
);

CREATE INDEX share_stream_member_stream ON share_stream_member(stream);

-- Per friend: the stream and snapshot (assign) we follow, the position in it,
-- where the full state being staged stands (base, staged_assign), and the
-- streams it replaced, whose late messages are dropped.
CREATE TABLE share_incoming (
    peer TEXT NOT NULL PRIMARY KEY REFERENCES share_person(peer) ON DELETE CASCADE,
    stream TEXT NOT NULL,
    assign INTEGER NOT NULL,
    generation INTEGER NOT NULL,
    sequence INTEGER NOT NULL,
    base INTEGER NOT NULL,
    staged_assign INTEGER NOT NULL,
    scope TEXT NOT NULL,
    expected_digest TEXT NOT NULL,
    expected_count INTEGER NOT NULL,
    staging TEXT NOT NULL,
    pending TEXT NOT NULL,
    gap_since INTEGER NOT NULL DEFAULT 0,
    resync_generation INTEGER NOT NULL DEFAULT 0,
    resync_at INTEGER NOT NULL DEFAULT 0,
    ack_due INTEGER NOT NULL DEFAULT 0,
    ack_sent_at INTEGER NOT NULL DEFAULT 0,
    received_at INTEGER NOT NULL,
    retired TEXT NOT NULL
);

-- expires_at: the friend's grant for this record ends then; this app deletes
-- the record at that moment even if the friend is not in reach.
CREATE TABLE share_record (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    category TEXT NOT NULL,
    revision INTEGER NOT NULL,
    climb_uuid TEXT,
    occurred_on TEXT,
    fields TEXT NOT NULL,
    expires_at INTEGER,
    PRIMARY KEY (peer, record_id)
);

CREATE INDEX share_record_climb ON share_record(climb_uuid);

-- Local history of one's own sharing decisions (FEAT-073 U2): never sent,
-- never in a backup, at most a year and 1,000 entries.
CREATE TABLE share_history (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    at INTEGER NOT NULL,
    peer TEXT,
    event TEXT NOT NULL,
    detail TEXT
);
