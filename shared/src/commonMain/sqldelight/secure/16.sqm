-- Migration 16 → 17: spray walls (FEAT-078).
--
-- Five new tables: walls, their immutable versions (photo + holds), the holds
-- per version, the climbs set on them and the private ascents logged on those
-- climbs. Purely additive, so every earlier secure database upgrades
-- untouched. The schema is described in com/cruxcoach/db/secure/SprayWalls.sq;
-- the statements below are the same CREATE statements.

CREATE TABLE spray_wall (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    angle INTEGER NOT NULL,
    visibility TEXT NOT NULL DEFAULT 'private',
    gym_id TEXT,
    gym_name TEXT,
    owner_pubkey TEXT,
    current_version INTEGER NOT NULL,
    published_version INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE spray_wall_version (
    wall_id TEXT NOT NULL,
    version INTEGER NOT NULL,
    kind TEXT NOT NULL,
    based_on INTEGER,
    photo_file TEXT NOT NULL,
    photo_width INTEGER NOT NULL,
    photo_height INTEGER NOT NULL,
    photo_sha256 TEXT,
    photo_url TEXT,
    hold_count INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    PRIMARY KEY (wall_id, version)
);

CREATE TABLE spray_wall_hold (
    wall_id TEXT NOT NULL,
    version INTEGER NOT NULL,
    hold_id INTEGER NOT NULL,
    x REAL NOT NULL,
    y REAL NOT NULL,
    radius REAL NOT NULL,
    PRIMARY KEY (wall_id, version, hold_id)
);

CREATE TABLE spray_climb (
    uuid TEXT NOT NULL PRIMARY KEY,
    wall_id TEXT NOT NULL,
    version INTEGER NOT NULL,
    name TEXT NOT NULL,
    description TEXT NOT NULL DEFAULT '',
    difficulty INTEGER,
    holds TEXT NOT NULL,
    author_pubkey TEXT,
    published_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX spray_climb_wall ON spray_climb(wall_id, created_at);

CREATE TABLE spray_ascent (
    uuid TEXT NOT NULL PRIMARY KEY,
    climb_uuid TEXT NOT NULL,
    wall_id TEXT NOT NULL,
    is_send INTEGER NOT NULL,
    tries INTEGER NOT NULL DEFAULT 1,
    difficulty INTEGER,
    comment TEXT,
    climbed_at TEXT NOT NULL
);

CREATE INDEX spray_ascent_climb ON spray_ascent(climb_uuid, climbed_at);

CREATE INDEX spray_ascent_wall ON spray_ascent(wall_id, is_send);
