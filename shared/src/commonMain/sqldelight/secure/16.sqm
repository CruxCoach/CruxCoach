-- Migration 16 → 17 (secure/personal DB): personal-data sharing, ported from
-- feat/marmot-permissions-v2 (schema 34 there) onto the 0.2.4 release line.
--
-- Purely additive: new tables, a seeded source counter and triggers; no existing
-- table or row is touched. The release line never carried the unpublished
-- feature migrations 14–33 of that branch (its 14/15 are different tables), so
-- nothing of v1 is dropped or reinterpreted here. The DDL is kept identical to
-- ContinuousSharing.sq and Share.sq so a migrated and a fresh database have the
-- same shape (SharingProjectionSchemaTest).

-- Source revisions of the owner's shareable rows, maintained by triggers in the
-- same transaction as every insert, update and delete.
CREATE TABLE sharing_continuous_source (
    singleton INTEGER NOT NULL PRIMARY KEY CHECK (singleton = 1),
    generation TEXT NOT NULL,
    revision INTEGER NOT NULL
);
INSERT INTO sharing_continuous_source VALUES (1, lower(hex(randomblob(16))), 0);


CREATE TABLE sharing_continuous_resource (
    resource_id TEXT NOT NULL PRIMARY KEY,
    revision INTEGER NOT NULL
);

CREATE TRIGGER sharing_continuous_user_profiles_insert
AFTER INSERT ON user_profiles
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'profile:active', revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_user_profiles_update
AFTER UPDATE OF name, max_boulder_grade, max_sport_grade, climbing_years, sessions_per_week, available_equipment, goals, updated_at ON user_profiles
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'profile:active', revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_user_profiles_delete
AFTER DELETE ON user_profiles
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'profile:active', revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_ascents_insert
AFTER INSERT ON ascents
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'ascent:' || new.uuid, revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_ascents_update
AFTER UPDATE OF uuid, climb_uuid, climb_name, board_brand, angle, bid_count, difficulty, climbed_at ON ascents
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'ascent:' || new.uuid, revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_ascents_delete
AFTER DELETE ON ascents
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    DELETE FROM sharing_continuous_resource WHERE resource_id = 'ascent:' || old.uuid;
END;

CREATE TRIGGER sharing_continuous_bids_insert
AFTER INSERT ON bids
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'bid:' || new.uuid, revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_bids_update
AFTER UPDATE OF uuid, climb_uuid, climb_name, board_brand, angle, bid_count, climbed_at ON bids
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'bid:' || new.uuid, revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_bids_delete
AFTER DELETE ON bids
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    DELETE FROM sharing_continuous_resource WHERE resource_id = 'bid:' || old.uuid;
END;

CREATE TRIGGER sharing_continuous_climb_notes_insert
AFTER INSERT ON climb_notes
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'note:' || new.climb_uuid, revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_climb_notes_update
AFTER UPDATE OF climb_uuid, note ON climb_notes
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    INSERT OR REPLACE INTO sharing_continuous_resource SELECT 'note:' || new.climb_uuid, revision FROM sharing_continuous_source WHERE singleton = 1;
END;

CREATE TRIGGER sharing_continuous_climb_notes_delete
AFTER DELETE ON climb_notes
BEGIN
    UPDATE sharing_continuous_source
    SET revision = CASE WHEN revision < 9223372036854775807 THEN revision + 1 ELSE revision END
    WHERE singleton = 1;
    DELETE FROM sharing_continuous_resource WHERE resource_id = 'note:' || old.climb_uuid;
END;

-- Personal-data sharing v2: the owner's local, unsigned policy, the state of
-- each direction of the sync protocol, and records received from friends.
-- Protocol data (groups, relays, events, delivery) lives in the native host.
-- Received records never enter canonical tables; they cascade with the person.

CREATE TABLE share_preset (
    circle TEXT NOT NULL PRIMARY KEY CHECK (circle IN ('ACQUAINTANCES', 'FRIENDS')),
    categories TEXT NOT NULL,
    training_days INTEGER NOT NULL CHECK (training_days >= -1)
);

-- Starting point for a newly created table only (owner decision 2026-09-23):
-- friends see profile & goals and 30 days of training history, acquaintances
-- profile & goals. Nothing reaches anyone before a person is added and accepts.
-- A later choice is an upsert of the same row and is never reset.
INSERT INTO share_preset(circle, categories, training_days) VALUES
    ('FRIENDS', 'PROFILE_AND_GOALS,TRAINING_HISTORY', 30),
    ('ACQUAINTANCES', 'PROFILE_AND_GOALS', 30);

CREATE TABLE share_person (
    peer TEXT NOT NULL PRIMARY KEY CHECK (length(peer) = 64),
    circle TEXT NOT NULL CHECK (circle IN ('ACQUAINTANCES', 'FRIENDS')),
    outgoing INTEGER NOT NULL CHECK (outgoing IN (0, 1)),
    training_days INTEGER CHECK (training_days IS NULL OR training_days >= -1),
    label TEXT,
    state TEXT NOT NULL CHECK (state IN ('REQUESTED', 'CONNECTED', 'ENDING', 'ENDED')),
    cancel_pending INTEGER NOT NULL DEFAULT 0 CHECK (cancel_pending IN (0, 1)),
    created_at INTEGER NOT NULL,
    ended_at INTEGER
);

CREATE TABLE share_person_rule (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    category TEXT NOT NULL CHECK (category IN ('PROFILE_AND_GOALS', 'TRAINING_HISTORY', 'PRIVATE_NOTES')),
    effect TEXT NOT NULL CHECK (effect IN ('ALLOW', 'DENY')),
    PRIMARY KEY (peer, category)
);

CREATE TABLE share_object_rule (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    category TEXT NOT NULL CHECK (category IN ('PROFILE_AND_GOALS', 'TRAINING_HISTORY', 'PRIVATE_NOTES')),
    effect TEXT NOT NULL CHECK (effect IN ('ALLOW', 'DENY')),
    PRIMARY KEY (peer, record_id)
);

CREATE TABLE share_outgoing (
    peer TEXT NOT NULL PRIMARY KEY REFERENCES share_person(peer) ON DELETE CASCADE,
    generation INTEGER NOT NULL,
    sequence INTEGER NOT NULL,
    generation_started_at INTEGER NOT NULL,
    scope TEXT NOT NULL,
    sent TEXT NOT NULL,
    digest TEXT NOT NULL,
    record_count INTEGER NOT NULL,
    manifest_at INTEGER NOT NULL,
    full_required INTEGER NOT NULL DEFAULT 0,
    acked_generation INTEGER NOT NULL DEFAULT 0,
    acked_sequence INTEGER NOT NULL DEFAULT -1,
    acked_at INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE share_incoming (
    peer TEXT NOT NULL PRIMARY KEY REFERENCES share_person(peer) ON DELETE CASCADE,
    generation INTEGER NOT NULL,
    sequence INTEGER NOT NULL,
    scope TEXT NOT NULL,
    expected_digest TEXT NOT NULL,
    expected_count INTEGER NOT NULL,
    staging TEXT NOT NULL,
    pending TEXT NOT NULL,
    resync_generation INTEGER NOT NULL DEFAULT 0,
    resync_at INTEGER NOT NULL DEFAULT 0,
    ack_due INTEGER NOT NULL DEFAULT 0,
    received_at INTEGER NOT NULL
);

CREATE TABLE share_record (
    peer TEXT NOT NULL REFERENCES share_person(peer) ON DELETE CASCADE,
    record_id TEXT NOT NULL,
    category TEXT NOT NULL CHECK (category IN ('PROFILE_AND_GOALS', 'TRAINING_HISTORY', 'PRIVATE_NOTES')),
    revision INTEGER NOT NULL,
    climb_uuid TEXT,
    occurred_on TEXT,
    fields TEXT NOT NULL,
    PRIMARY KEY (peer, record_id)
);

CREATE INDEX share_record_climb ON share_record(climb_uuid);
