<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Internet access for Kilter Board sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notification permission (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Vibration for rest timer -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- FEAT-058 competition QR scanning. Requested only when the scanner is
         opened, never at startup, and the app runs perfectly well without it:
         a competition can also be joined by App Link, by pasting, or from a
         share sheet. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- FEAT-004 in-app updater. Silent self-update is strictly opt-in and
         available only when Android's PackageInstaller conditions are met. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <!-- FEAT-004 in-app updater: DownloadManager.setNotificationVisibility(
         VISIBILITY_HIDDEN) requires this permission — we post our own
         progress UI so the system notification would be a duplicate. -->
    <uses-permission android:name="android.permission.DOWNLOAD_WITHOUT_NOTIFICATION" />

    <!-- Foreground service for background sync notifications -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Exact alarms for the rest timer. SCHEDULE_EXACT_ALARM (API 31)
         can be revoked on API 33+, silently degrading the timer to an
         inexact (Doze-delayed) alarm. USE_EXACT_ALARM is the alarm/timer
         use-case permission, granted by default on API 33+ and not
         user-revocable, so the rest timer always fires on time. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- BLE: legacy permissions for Android 11 and below (install-time, no runtime prompt) -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLE: Android 12+ granular permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />

    <!-- Wi-Fi Direct requires fine location through Android 12; Android 12
         additionally requires coarse+fine to be requested as a pair. BLE
         uses these declarations on older releases too. Android 13+ uses the
         nearby-device permissions above instead. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <uses-feature android:name="android.hardware.bluetooth_le" android:required="false" />

    <queries>
        <package android:name="com.greenart7c3.nostrsigner" />
        <package android:name="dev.zapstore.app" />
        <package android:name="org.fdroid.fdroid" />
        <!-- OEM autostart / battery settings apps (NotificationReliabilityHelper
             resolves component-targeted intents into these; API 30+ blocks
             package visibility unless declared here). -->
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.huawei.systemmanager" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.meizu.safe" />
        <package android:name="com.samsung.android.lool" />
        <package android:name="com.samsung.android.sm" />
        <package android:name="com.oneplus.security" />
    </queries>

    <application
        android:name=".CruxCoachApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config"
        android:theme="@style/Theme.CruxCoach">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.CruxCoach.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep link: cruxcoach://import-board-db?url=http://... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cruxcoach" android:host="import-board-db" />
            </intent-filter>
            <!-- One-scan path when CruxCoach is already installed. The QR
                 carries the ephemeral hotspot credentials and local server
                 address; the receiving app requests that exact Wi-Fi. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cruxcoach" android:host="offline-share" />
            </intent-filter>
            <!-- Android App Link: https://${appLinkHost}/c/<naddr> opens the
                 climb directly in the app when installed (verified via
                 https://${appLinkHost}/.well-known/assetlinks.json).
                 Falls back to browser when the app isn't installed or the
                 verification has not completed yet. The host is supplied
                 by build.gradle.kts via manifestPlaceholders["appLinkHost"]
                 so forks override it from local.properties without
                 editing the manifest. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https"
                      android:host="${appLinkHost}"
                      android:pathPrefix="/c/" />
                <!-- /l/<payload>: shared playlist import (base64url-packed
                     name + (angle, climb-uuid) sequence). -->
                <data android:scheme="https"
                      android:host="${appLinkHost}"
                      android:pathPrefix="/l/" />
                <!-- FEAT-058: a competition join link. The same URL the website
                     serves and a QR code carries, so the phone's own camera app
                     opens the competition here without an in-app scanner. -->
                <data android:scheme="https"
                      android:host="${appLinkHost}"
                      android:pathPrefix="/comp/" />
            </intent-filter>
        </activity>

        <!-- AppCompat per-app language persistence (pre-Android 13) -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data android:name="autoStoreLocales" android:value="true" />
        </service>

        <!-- FileProvider for APK sharing -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- WorkManager foreground service type for BoardSyncWorker -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- FEAT-044 CruxRelay: keeps BLE advertising alive while sharing the
             board + hosts the persistent sharing notification. -->
        <service
            android:name=".data.CruxRelayService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".fips.FipsMeshService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Keeps the sender-side Wi-Fi hotspot and local HTTP server alive
             while the share screen is backgrounded. -->
        <service
            android:name=".util.LocalShareService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- Rest timer alarm receiver (fires in Doze mode) -->
        <receiver
            android:name=".notification.RestTimerAlarmReceiver"
            android:exported="false" />

        <!-- FEAT-004 updater: notification-action taps (Download / Install /
             Dismiss) dispatch here even after the Activity has died. -->
        <receiver
            android:name=".updater.UpdaterActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cruxcoach.android.updater.ACTION_DOWNLOAD" />
                <action android:name="com.cruxcoach.android.updater.ACTION_INSTALL" />
                <action android:name="com.cruxcoach.android.updater.ACTION_DISMISS" />
            </intent-filter>
        </receiver>

        <!-- Continue verification/install even if DownloadManager outlives the app process. -->
        <receiver
            android:name=".updater.ApkDownloadCompleteReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.DOWNLOAD_COMPLETE" />
            </intent-filter>
        </receiver>

        <!-- PackageInstaller status callbacks (§5.5). -->
        <receiver
            android:name=".updater.ApkInstallStatusReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.cruxcoach.android.updater.INSTALL_STATUS" />
            </intent-filter>
        </receiver>

        <!-- Disable default WorkManager initializer (we use HiltWorkerFactory) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
