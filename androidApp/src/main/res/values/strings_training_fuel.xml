<resources>
    <string name="trf_intro_title">Nutrition: energy for training</string>
    <string name="trf_intro_p1">Enough energy is the base for strength, skin and recovery. CruxCoach helps you eat to match your training – not less.</string>
    <string name="trf_intro_protein">Protein follows your body weight (about 1.4–2.0 g per kg).</string>
    <string name="trf_intro_carbs">Carbohydrates follow your training: more on board and strength days, less on rest days – automatically from your sessions.</string>
    <string name="trf_intro_no_budget">No calorie budget, no “too much”, no good or bad foods.</string>
    <string name="trf_intro_hidden">Calories are shown with every value; you can hide them in the settings.</string>
    <string name="trf_intro_private">Everything stays encrypted on your device.</string>
    <string name="trf_intro_got_it">Got it</string>

