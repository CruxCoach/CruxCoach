    <!-- Intro -->
    <string name="yr_intro_title">Your year on the boards</string>
    <string name="yr_intro_lead">Made on this phone. Nothing leaves it unless you share it.</string>
    <string name="yr_intro_spray_walls">Spray walls are not counted yet.</string>
    <string name="yr_intro_how">Counted from 1 January to 31 December in your time zone, from your logbook on every board, imported logbooks included, and from the climbing days, climbs and workouts you logged. Spray walls are not counted yet: they follow with the logbook statistics.</string>
    <string name="yr_intro_how_so_far">Counted from 1 January up to today in your time zone, from your logbook on every board, imported logbooks included, and from the climbing days, climbs and workouts you logged. Spray walls are not counted yet: they follow with the logbook statistics. The year is not over yet: it counts on until 31 December.</string>
    <string name="yr_intro_so_far">as of %1$s</string>

    <!-- Volume -->
    <string name="yr_volume_title">Your volume</string>
    <string name="yr_volume_hero_label">climbing days</string>
    <string name="yr_volume_days_row">Climbing days</string>
    <string name="yr_volume_board_days">Days on the board</string>
    <string name="yr_volume_sessions">Timed sessions</string>
    <string name="yr_volume_session_time">%1$s on the board</string>
    <string name="yr_volume_tries">Tries</string>
    <string name="yr_volume_sends">Sends</string>
    <string name="yr_volume_first_sends">New problems sent</string>
    <string name="yr_volume_flashes">Flashes</string>
    <string name="yr_volume_how">A climbing day is a day with a board entry, or with a climbing day or a climb you logged by hand. A send counts its tries, at least one. Sends are every successful entry, repeats included. A new problem is one you sent for the first time ever, per problem and angle; a flash is a new problem sent on the first try.</string>

    <!-- Boards and angles -->
    <string name="yr_boards_title">Your boards</string>
    <string name="yr_boards_angle">mostly at %1$d° (%2$d%%)</string>
    <string name="yr_boards_angle_only">at %1$d°</string>
    <string name="yr_boards_how">Entries are your sends and attempts on that board. The angle is the one you logged most there, with its share of the board\'s entries.</string>

    <!-- Hardest -->
    <string name="yr_hardest_title">Hardest sends</string>
    <string name="yr_hardest_flash">flash</string>
    <string name="yr_hardest_repeat">repeat</string>
    <string name="yr_hardest_sample">out of %1$s with a grade</string>
    <string name="yr_hardest_how">Per board, in the grade scale you chose, from the grade the problem has at its angle. Grades are never compared across boards. Each problem counts once; with few sends a grade says less.</string>

    <!-- Compared with last year -->
    <string name="yr_compared_title">Compared with %1$d</string>
    <string name="yr_compared_before">%2$d: %1$s</string>
    <string name="yr_compared_how">Last year from 1 January to %1$s, the same span as this year. Only your own earlier years count, never other climbers.</string>

    <!-- Rhythm -->
    <string name="yr_rhythm_title">Your rhythm</string>
    <string name="yr_rhythm_hero_label">busiest month, %1$s</string>
    <string name="yr_rhythm_weeks">Weeks with climbing</string>
    <string name="yr_rhythm_weeks_value">%1$d of %2$d</string>
    <string name="yr_rhythm_streak">Longest run</string>
    <string name="yr_rhythm_streak_from">from %1$s</string>
    <string name="yr_rhythm_weekday">Favourite day</string>
    <string name="yr_rhythm_how">Weeks run from Monday to Sunday; a run counts weeks in a row with at least one climbing day. On a tie, the earlier month or weekday wins.</string>

    <!-- Highlights -->
    <string name="yr_highlights_title">Highlights</string>
    <string name="yr_highlights_flash">Hardest flash on the %1$s</string>
    <string name="yr_highlights_biggest_day">Biggest day</string>
    <string name="yr_highlights_repeated">Most repeated</string>
    <string name="yr_highlights_project">Longest project</string>
    <string name="yr_highlights_project_since">since %1$s</string>
    <string name="yr_highlights_how">The biggest day is the one with the most sends. The most repeated problem is the one you sent most often this year. The longest project is the new problem that took the most tries, counted across all sessions up to the send, even from earlier years.</string>

    <!-- Holds touched -->
    <string name="yr_touched_title">Hold by hold</string>
    <string name="yr_touched_hero_label">holds touched on your sends</string>
    <string name="yr_touched_per_send">Per send</string>
    <string name="yr_touched_holds_value">%1$s holds</string>
    <string name="yr_touched_most">Most holds</string>
    <string name="yr_touched_how">Every hold a problem marks counts once per send, repeats included: start, hand and finish holds, and foot holds where the board marks them. Tries without a send do not count. A rough count: on the wall you may skip a hold or use one twice.</string>
    <string name="yr_touched_how_all">Counted from all your %1$s.</string>
    <string name="yr_touched_how_some">Counted from %1$s of your %2$s; the holds of the other problems are not on this phone.</string>

    <!-- Hold types -->
    <string name="yr_holds_title">Your holds</string>
    <string name="yr_holds_hero_label">on %1$s of the %2$s you tagged</string>
    <string name="yr_holds_how">From the hold types you tagged on the climbs you logged by hand: how many of those %1$s carry each type. A climb can have several. Board problems will get their hold types later.</string>

