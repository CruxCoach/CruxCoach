    <string name="yr_training_how">Finished workouts you logged in the training section, with their time. Best values are the newest you measured per exercise this year; quick estimates do not count.</string>

    <!-- Climber type -->
    <string name="yr_type_title">Your climber type</string>
    <string name="yr_type_also">Also: %1$s</string>
    <string name="yr_type_how">One of ten types, picked by rules on your own numbers: the type whose rule you exceed most wins. A comeback is only ever shown as a break, never why.</string>
    <string name="yr_type_flash_machine">Flash Machine</string>
    <string name="yr_type_flash_machine_line">Sees it, sends it.</string>
    <string name="yr_type_projector">Projector</string>
    <string name="yr_type_projector_line">Never lets a problem go.</string>
    <string name="yr_type_mileage_monster">Mileage Monster</string>
    <string name="yr_type_mileage_monster_line">More problems, more fun.</string>
    <string name="yr_type_steep_specialist">Steep Specialist</string>
    <string name="yr_type_steep_specialist_line">The steeper, the better.</string>
    <string name="yr_type_board_hopper">Board Hopper</string>
    <string name="yr_type_board_hopper_line">At home on every board.</string>
    <string name="yr_type_clockwork">Clockwork</string>
    <string name="yr_type_clockwork_line">Week in, week out.</string>
    <string name="yr_type_rising_star">Rising Star</string>
    <string name="yr_type_rising_star_line">Up the grades.</string>
    <string name="yr_type_strength_lab">Strength Lab</string>
    <string name="yr_type_strength_lab_line">Builds the engine off the wall.</string>
    <string name="yr_type_comeback_kid">Comeback Kid</string>
    <string name="yr_type_comeback_kid_line">Came back and kept climbing.</string>
    <string name="yr_type_all_rounder">All-Rounder</string>
    <string name="yr_type_all_rounder_line">A bit of everything. That\'s a style too.</string>
    <!-- The rule with the user's number; %1$s is the user's value, %2$s the threshold. -->
    <string name="yr_rule_flash">%1$s of your new problems were flashes. Flash Machines start at %2$s.</string>
    <string name="yr_rule_projector_share">%1$s of your new problems took 10 tries or more. Projectors start at %2$s.</string>
    <string name="yr_rule_projector_average">Your new problems took %1$s tries on average. Projectors start at %2$s.</string>
    <string name="yr_rule_mileage">%1$s sends per day on the board. Mileage Monsters start at %2$s.</string>
    <string name="yr_rule_steep">%1$s of your entries were at 45° or steeper (40° on a MoonBoard). Steep Specialists start at %2$s.</string>
    <string name="yr_rule_hopper">Your third board had %1$s of your entries. Board Hoppers start at %2$s on three boards.</string>
    <string name="yr_rule_clockwork_share">You climbed in %1$s of the weeks since your first climbing day this year. Clockworks start at %2$s.</string>
    <string name="yr_rule_clockwork_streak">%1$s in a row with climbing. Clockworks start at %2$s.</string>
    <string name="yr_rule_rising_last_year">%1$s above last year on your main board. Rising Stars start at %2$s.</string>
    <string name="yr_rule_rising_within">%1$s from your first three months to your last three on your main board. Rising Stars start at %2$s.</string>
    <string name="yr_rule_strength">Workouts on %1$s of your training days. Strength Labs start at %2$s, with 20 workouts.</string>
    <string name="yr_rule_comeback_plan">Back after a break, and kept at it.</string>
    <string name="yr_rule_comeback_break">Back after a break of %1$s, with %2$s since.</string>
