<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ data-extraction rules. Mirrors backup_rules.xml — same
    exclusions for cloud-backup (Google Drive) and device-transfer
    (same-device or near-device restore). Keep both files in sync.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="nostr_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="nostr_flags.xml"/>
        <exclude domain="sharedpref" path="sqlcipher_prefs.xml"/>
        <exclude domain="sharedpref" path="kilter_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="amber_config.xml"/>
        <exclude domain="file" path="datastore"/>
        <!-- Plain board catalog DB — see backup_rules.xml for rationale. -->
        <exclude domain="database" path="cruxcoach.db"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="nostr_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="nostr_flags.xml"/>
        <exclude domain="sharedpref" path="sqlcipher_prefs.xml"/>
        <exclude domain="sharedpref" path="kilter_secure_prefs.xml"/>
        <exclude domain="sharedpref" path="amber_config.xml"/>
        <exclude domain="file" path="datastore"/>
        <exclude domain="database" path="cruxcoach.db"/>
    </device-transfer>
</data-extraction-rules>
