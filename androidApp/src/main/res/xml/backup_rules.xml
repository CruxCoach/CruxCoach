<?xml version="1.0" encoding="utf-8"?>
<!--
    Cloud-backup / device-transfer exclusion list. Any identity-linkable
    or credential-bearing state lives here so a restored APK starts
    fresh with whatever identity the new user imports, rather than
    silently leaking a prior Nostr account across a Google-Drive
    restore onto a different device.
-->
<full-backup-content>
    <!-- EncryptedSharedPreferences holding the nsec (Keystore-wrapped;
         cannot decrypt on a different device anyway, but excluding
         avoids dead bytes + any future export-attack surface). -->
    <exclude domain="sharedpref" path="nostr_secure_prefs.xml"/>
    <!-- Plain SharedPreferences for nsec-related flags
         (e.g. identity_reset) — low-sensitivity individually, but
         still identity-scoped state. -->
    <exclude domain="sharedpref" path="nostr_flags.xml"/>
    <!-- SQLCipher salt / key-derivation state. -->
    <exclude domain="sharedpref" path="sqlcipher_prefs.xml"/>
    <!-- Kilter OAuth tokens, per-pubkey-prefixed, EncryptedSharedPrefs. -->
    <exclude domain="sharedpref" path="kilter_secure_prefs.xml"/>
    <!-- Amber signer config: pubkey hex + Amber package name. Would
         cross-device-leak the user's npub on a Google-Drive restore. -->
    <exclude domain="sharedpref" path="amber_config.xml"/>

    <!-- DataStore files under filesDir/datastore/ — holds FEAT-002
         BackupPreferences (wrapped dataKey, d-tag HMACs, previous-blob
         SHA, last-sync timestamps, device id), UserPreferences,
         NIP65_RESOLVED_RELAYS cache, updater state, and the per-pubkey
         keyScoped files. Excluding the whole subdir is the simplest
         forward-compatible catch-all — every new DataStore we add is
         covered automatically. -->
    <exclude domain="file" path="datastore"/>
    <!-- Plain (non-SQLCipher) board catalog DB. Holds public Kilter
         board content but FEAT-003 added identity-linkable columns:
         created_by_pubkey (Nostr identity), nostr_event_id / nostr_d_tag
         (own publish trail), kilter_error (Kilter API responses, may
         carry server-side hostnames or request echoes). All of those
         re-key cleanly on a fresh install via re-sync, so excluding the
         DB from cloud-backup is both privacy-correct and lossless. -->
    <exclude domain="database" path="cruxcoach.db"/>
</full-backup-content>
