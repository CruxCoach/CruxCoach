"whatsnew_gym_picker_action_now" = "Einstellungen öffnen";
"whatsnew_gym_picker_body" = "In Einstellungen → Board-Größe öffnet „Ändern“ jetzt einen „Halle suchen“-Pfad. Halle suchen, Wand antippen, fertig — ohne den Product-Size-Code aus der Dropdown raten zu müssen.";
"whatsnew_gym_picker_hint" = "Die manuelle Liste bleibt als Fallback für Setter und Homewall-Besitzer, die ihre Hardware ohnehin kennen.";
"whatsnew_gym_picker_title" = "Neu: Board über die Halle wählen";
